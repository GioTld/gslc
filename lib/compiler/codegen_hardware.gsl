import "compiler/codegen_operations"

const ASM_LITERAL_ARGUMENTS: u32 = 2

func codegen_emit_syscall(p: *Parser, expr_idx: u32, output: *CompilerOutput, ctx: *Codegen) u32 {
    let node = parser_expr(p, expr_idx)
    var arg_idx = node.call.arg_start
    var count: u32 = 0
    while count < node.call.arg_count {
        let arg_type = codegen_expr_type(p, arg_idx, ctx, 64)
        let is_signed = codegen_expr_signed(p, arg_idx, ctx, false)
        let value = codegen_emit_expr(p, arg_idx, output, ctx, 64, is_signed)
        if arg_type != 64 && ctx.replay_call != expr_idx {
            ctx.next_reg += 1
            let converted = ctx.next_reg
            var cast: IrCast
            cast.source_type = arg_type
            cast.target_type = 64
            cast.result = converted
            cast.operand = value
            cast.opcode = IR_ZEXT
            if type_is_pointer(p, arg_type) { cast.opcode = IR_PTR_TO_INT } else if is_signed { cast.opcode = IR_SEXT }
            ir_append_cast(ctx.function, &cast)
            parser_expr(p, arg_idx).value_reg = converted
        }
        arg_idx = parser_expr(p, arg_idx).next_arg
        count += 1
    }
    if ctx.capture_call == expr_idx { return 0 }
    ctx.next_reg += 1
    var operation: IrSyscall
    operation.result = ctx.next_reg
    operation.argument_count = node.call.arg_count
    operation.write_number = codegen_builtin(p, expr_idx) == BUILTIN_SYSCALL_WRITE
    codegen_capture_arguments(p, ctx, node.call.arg_start, node.call.arg_count)
    if ctx.error { return 0 }
    ir_append_syscall(ctx.function, ctx.arguments, &operation)
    return operation.result
}

func codegen_write_symbol(p: *Parser, output: *CompilerOutput, arg: u32) {
    let value = parser_expr(p, arg)
    var name: *u8
    // Preflight validates the literal; its bytes live in the parser source buffer.
    unsafe { name = parser_source_ptr(p, value.span.start + 1 as usize) }
    codegen_write_token(p, output, name, value.span.end - value.span.start - 2 as usize)
}

func codegen_emit_symbols(p: *Parser, output: *CompilerOutput, kernel: bool) {
    var index: u32 = 0
    while index < p.expr_count {
        let node = parser_expr(p, index)
        if node.kind == EXPR_CALL && codegen_builtin(p, index) == BUILTIN_SYMBOL_ADDRESS {
            let arg = parser_expr(p, node.call.arg_start)
            var name: *u8
            unsafe { name = parser_source_ptr(p, arg.span.start + 1 as usize) }
            let length = arg.span.end - arg.span.start - 2 as usize
            var duplicate = codegen_find_decl(p, name, length) != INVALID_INDEX || codegen_find_global(p, name, length) != INVALID_INDEX
            if kernel && (compiler_name_is(name, length, "memcpy") || compiler_name_is(name, length, "memset") || compiler_name_is(name, length, "memmove") || compiler_name_is(name, length, "memcmp")) { duplicate = true }
            var previous: u32 = 0
            while previous < index {
                let other = parser_expr(p, previous)
                if other.kind == EXPR_CALL && codegen_builtin(p, previous) == BUILTIN_SYMBOL_ADDRESS {
                    let literal = parser_expr(p, other.call.arg_start)
                    var previous_name: *u8
                    unsafe { previous_name = parser_source_ptr(p, literal.span.start + 1 as usize) }
                    if parser_type_equal(name, length, previous_name, literal.span.end - literal.span.start - 2 as usize) { duplicate = true }
                }
                previous += 1
            }
            if duplicate == false {
                compiler_output_string(output, "@")
                codegen_write_symbol(p, output, node.call.arg_start)
                compiler_output_string(output, " = external global i8\n")
            }
        }
        index += 1
    }
}

func codegen_emit_assembly(p: *Parser, index: u32, output: *CompilerOutput, ctx: *Codegen, result: bool) u32 {
    let node = parser_expr(p, index)
    let instruction = node.call.arg_start
    let constraints = parser_expr(p, instruction).next_arg
    var arg = parser_expr(p, constraints).next_arg
    var position: u32 = ASM_LITERAL_ARGUMENTS
    while position < node.call.arg_count {
        parser_expr(p, arg).value_reg = codegen_emit_expr(p, arg, output, ctx, 64, false)
        arg = parser_expr(p, arg).next_arg
        position += 1
    }
    if ctx.capture_call == index { return 0 }
    var operation: IrAssembly
    operation.result = 0
    operation.returns_value = result
    if result { ctx.next_reg += 1; operation.result = ctx.next_reg }
    let text = parser_expr(p, instruction)
    let constraint = parser_expr(p, constraints)
    operation.instruction_start = text.span.start + 1 as usize
    operation.instruction_end = text.span.end - 1 as usize
    operation.constraint_start = constraint.span.start + 1 as usize
    operation.constraint_end = constraint.span.end - 1 as usize
    operation.argument_count = node.call.arg_count - ASM_LITERAL_ARGUMENTS
    operation.literal_only = false
    codegen_capture_arguments(p, ctx, parser_expr(p, constraints).next_arg, operation.argument_count)
    if ctx.error { return 0 }
    ir_append_assembly(ctx.function, ctx.arguments, &operation)
    return operation.result
}

func codegen_emit_hardware(p: *Parser, index: u32, output: *CompilerOutput, ctx: *Codegen, hardware: u32) u32 {
    let node = parser_expr(p, index)
    if hardware == BUILTIN_ASM_U64 || hardware == BUILTIN_ASM_VOID { return codegen_emit_assembly(p, index, output, ctx, hardware == BUILTIN_ASM_U64) }
    if hardware == BUILTIN_SYMBOL_ADDRESS {
        if ctx.capture_call == index { return 0 }
        let arg = parser_expr(p, node.call.arg_start)
        var symbol: IrSymbolAddress
        unsafe { symbol.name = parser_source_ptr(p, arg.span.start + 1 as usize) }
        symbol.length = arg.span.end - arg.span.start - 2 as usize
        ctx.next_reg += 1
        symbol.result = ctx.next_reg
        symbol.string_index = 0
        symbol.is_string = false
        symbol.as_integer = true
        ir_append_symbol_address(ctx.function, &symbol)
        return symbol.result
    }
    if hardware == BUILTIN_ASM {
        if ctx.capture_call == index { return 0 }
        let arg = parser_expr(p, node.call.arg_start)
        var assembly: IrAssembly
        assembly.result = 0
        assembly.returns_value = false
        assembly.instruction_start = arg.span.start + 1 as usize
        assembly.instruction_end = arg.span.end - 1 as usize
        assembly.constraint_start = 0 as usize
        assembly.constraint_end = 0 as usize
        assembly.argument_count = 0
        assembly.literal_only = true
        ir_append_assembly(ctx.function, ctx.arguments, &assembly)
        return 0
    }
    var operation: IrHardware
    operation.builtin = hardware
    operation.result = 0
    operation.first = 0
    operation.second = 0
    if hardware == BUILTIN_CLI || hardware == BUILTIN_HLT || hardware == BUILTIN_STI || hardware == BUILTIN_READ_CR2 || hardware == BUILTIN_READ_CR3 {
        if ctx.capture_call == index { return 0 }
        if hardware == BUILTIN_READ_CR2 || hardware == BUILTIN_READ_CR3 { ctx.next_reg += 1; operation.result = ctx.next_reg }
        ir_append_hardware(ctx.function, &operation)
        return operation.result
    }
    var width: u32 = 64
    if hardware == BUILTIN_INB || hardware == BUILTIN_OUTB || hardware == BUILTIN_INW || hardware == BUILTIN_OUTW { width = 16 }
    let first = codegen_emit_expr(p, node.call.arg_start, output, ctx, width, false)
    var second: u32 = 0
    if hardware == BUILTIN_OUTB { second = codegen_emit_expr(p, parser_expr(p, node.call.arg_start).next_arg, output, ctx, 8, false) }
    if hardware == BUILTIN_OUTW { second = codegen_emit_expr(p, parser_expr(p, node.call.arg_start).next_arg, output, ctx, 16, false) }
    if ctx.capture_call == index { return 0 }
    operation.first = first
    operation.second = second
    if hardware == BUILTIN_INB || hardware == BUILTIN_INW { ctx.next_reg += 1; operation.result = ctx.next_reg }
    ir_append_hardware(ctx.function, &operation)
    return operation.result
}


// Snapshot only after recursive argument evaluation has finished.
func codegen_capture_arguments(p: *Parser, ctx: *Codegen, start: u32, count: u32) {
    var expression = start
    var index: u32 = 0
    while index < count {
        if compiler_pool_ensure(ctx.arguments, index, size_of(IrArgument), IR_ARGUMENT_BLOCK_BYTES) == false { ctx.error = true; return }
        let argument = codegen_ir_argument(ctx.arguments, index)
        argument.type_id = 64
        argument.value = parser_expr(p, expression).value_reg
        expression = parser_expr(p, expression).next_arg
        index += 1
    }
}
