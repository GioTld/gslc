import "compiler/codegen_types"

func codegen_runtime_defined(p: *Parser, name: string) bool {
    var bytes: *u8
    unsafe { bytes = name as *u8 }
    return codegen_find_decl(p, bytes, strlen(name) as usize) != INVALID_INDEX
}

func codegen_emit_runtime(p: *Parser, output: *CompilerOutput) {
    if codegen_runtime_defined(p, "memcpy") == false {
        compiler_output_string(output, "define weak ptr @memcpy(ptr %dst, ptr %src, i64 %count) noinline optnone #0 {\n")
        compiler_output_string(output, "entry:\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "loop:\n")
        compiler_output_string(output, "  %i = phi i64 [0, %entry], [%next, %write]\n")
        compiler_output_string(output, "  %done = icmp eq i64 %i, %count\n")
        compiler_output_string(output, "  br i1 %done, label %end, label %write\n")
        compiler_output_string(output, "write:\n")
        compiler_output_string(output, "  %s = getelementptr i8, ptr %src, i64 %i\n")
        compiler_output_string(output, "  %d = getelementptr i8, ptr %dst, i64 %i\n")
        compiler_output_string(output, "  %v = load volatile i8, ptr %s, align 1\n")
        compiler_output_string(output, "  store volatile i8 %v, ptr %d, align 1\n")
        compiler_output_string(output, "  %next = add i64 %i, 1\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "end:\n")
        compiler_output_string(output, "  ret ptr %dst\n")
        compiler_output_string(output, "}\n")
    }
    if codegen_runtime_defined(p, "memset") == false {
        compiler_output_string(output, "define weak ptr @memset(ptr %dst, i32 %value, i64 %count) noinline optnone #0 {\n")
        compiler_output_string(output, "entry:\n")
        compiler_output_string(output, "  %byte = trunc i32 %value to i8\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "loop:\n")
        compiler_output_string(output, "  %i = phi i64 [0, %entry], [%next, %write]\n")
        compiler_output_string(output, "  %done = icmp eq i64 %i, %count\n")
        compiler_output_string(output, "  br i1 %done, label %end, label %write\n")
        compiler_output_string(output, "write:\n")
        compiler_output_string(output, "  %d = getelementptr i8, ptr %dst, i64 %i\n")
        compiler_output_string(output, "  store volatile i8 %byte, ptr %d, align 1\n")
        compiler_output_string(output, "  %next = add i64 %i, 1\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "end:\n")
        compiler_output_string(output, "  ret ptr %dst\n")
        compiler_output_string(output, "}\n")
    }
    if codegen_runtime_defined(p, "memmove") == false {
        compiler_output_string(output, "define weak ptr @memmove(ptr %dst, ptr %src, i64 %count) noinline optnone #0 {\n")
        compiler_output_string(output, "entry:\n")
        compiler_output_string(output, "  %forward = icmp ule ptr %dst, %src\n")
        compiler_output_string(output, "  br i1 %forward, label %ascending, label %descending\n")
        compiler_output_string(output, "ascending:\n")
        compiler_output_string(output, "  br label %up\n")
        compiler_output_string(output, "up:\n")
        compiler_output_string(output, "  %i = phi i64 [0, %ascending], [%next, %upwrite]\n")
        compiler_output_string(output, "  %done = icmp eq i64 %i, %count\n")
        compiler_output_string(output, "  br i1 %done, label %end, label %upwrite\n")
        compiler_output_string(output, "upwrite:\n")
        compiler_output_string(output, "  %s = getelementptr i8, ptr %src, i64 %i\n")
        compiler_output_string(output, "  %d = getelementptr i8, ptr %dst, i64 %i\n")
        compiler_output_string(output, "  %v = load volatile i8, ptr %s, align 1\n")
        compiler_output_string(output, "  store volatile i8 %v, ptr %d, align 1\n")
        compiler_output_string(output, "  %next = add i64 %i, 1\n")
        compiler_output_string(output, "  br label %up\n")
        compiler_output_string(output, "descending:\n")
        compiler_output_string(output, "  br label %down\n")
        compiler_output_string(output, "down:\n")
        compiler_output_string(output, "  %remaining = phi i64 [%count, %descending], [%previous, %downwrite]\n")
        compiler_output_string(output, "  %finished = icmp eq i64 %remaining, 0\n")
        compiler_output_string(output, "  br i1 %finished, label %end, label %downwrite\n")
        compiler_output_string(output, "downwrite:\n")
        compiler_output_string(output, "  %previous = sub i64 %remaining, 1\n")
        compiler_output_string(output, "  %sback = getelementptr i8, ptr %src, i64 %previous\n")
        compiler_output_string(output, "  %dback = getelementptr i8, ptr %dst, i64 %previous\n")
        compiler_output_string(output, "  %vback = load volatile i8, ptr %sback, align 1\n")
        compiler_output_string(output, "  store volatile i8 %vback, ptr %dback, align 1\n")
        compiler_output_string(output, "  br label %down\n")
        compiler_output_string(output, "end:\n")
        compiler_output_string(output, "  ret ptr %dst\n")
        compiler_output_string(output, "}\n")
    }
    if codegen_runtime_defined(p, "memcmp") == false {
        compiler_output_string(output, "define weak i32 @memcmp(ptr %left, ptr %right, i64 %count) noinline optnone #0 {\n")
        compiler_output_string(output, "entry:\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "loop:\n")
        compiler_output_string(output, "  %i = phi i64 [0, %entry], [%next, %equal]\n")
        compiler_output_string(output, "  %done = icmp eq i64 %i, %count\n")
        compiler_output_string(output, "  br i1 %done, label %end, label %read\n")
        compiler_output_string(output, "read:\n")
        compiler_output_string(output, "  %l = getelementptr i8, ptr %left, i64 %i\n")
        compiler_output_string(output, "  %r = getelementptr i8, ptr %right, i64 %i\n")
        compiler_output_string(output, "  %a = load volatile i8, ptr %l, align 1\n")
        compiler_output_string(output, "  %b = load volatile i8, ptr %r, align 1\n")
        compiler_output_string(output, "  %same = icmp eq i8 %a, %b\n")
        compiler_output_string(output, "  br i1 %same, label %equal, label %different\n")
        compiler_output_string(output, "equal:\n")
        compiler_output_string(output, "  %next = add i64 %i, 1\n")
        compiler_output_string(output, "  br label %loop\n")
        compiler_output_string(output, "different:\n")
        compiler_output_string(output, "  %awide = zext i8 %a to i32\n")
        compiler_output_string(output, "  %bwide = zext i8 %b to i32\n")
        compiler_output_string(output, "  %difference = sub i32 %awide, %bwide\n")
        compiler_output_string(output, "  ret i32 %difference\n")
        compiler_output_string(output, "end:\n")
        compiler_output_string(output, "  ret i32 0\n")
        compiler_output_string(output, "}\n")
    }
}

func codegen_emit_zero_helper(output: *CompilerOutput) {
    compiler_output_string(output, "define void @gsl.array.zero(ptr %base, i64 %size) noinline optnone #0 {\n")
    compiler_output_string(output, "entry:\n")
    compiler_output_string(output, "  br label %loop\n")
    compiler_output_string(output, "loop:\n")
    compiler_output_string(output, "  %index = phi i64 [0, %entry], [%next, %write]\n")
    compiler_output_string(output, "  %done = icmp eq i64 %index, %size\n")
    compiler_output_string(output, "  br i1 %done, label %end, label %write\n")
    compiler_output_string(output, "write:\n")
    compiler_output_string(output, "  %address = getelementptr i8, ptr %base, i64 %index\n")
    compiler_output_string(output, "  store i8 0, ptr %address, align 1\n")
    compiler_output_string(output, "  %next = add i64 %index, 1\n")
    compiler_output_string(output, "  br label %loop\n")
    compiler_output_string(output, "end:\n")
    compiler_output_string(output, "  ret void\n")
    compiler_output_string(output, "}\n")
}

func codegen_emit_arena_helpers(output: *CompilerOutput) {
    compiler_output_string(output, "%gsl.arena = type { ptr, i64, i64 }\n")
    compiler_output_string(output, "define void @gsl.arena.init(ptr %arena, ptr %buffer, i64 %capacity) #0 {\n")
    compiler_output_string(output, "entry:\n")
    compiler_output_string(output, "  %base = getelementptr %gsl.arena, ptr %arena, i32 0, i32 0\n")
    compiler_output_string(output, "  %offset = getelementptr %gsl.arena, ptr %arena, i32 0, i32 1\n")
    compiler_output_string(output, "  %cap = getelementptr %gsl.arena, ptr %arena, i32 0, i32 2\n")
    compiler_output_string(output, "  store ptr %buffer, ptr %base, align 8\n")
    compiler_output_string(output, "  store i64 0, ptr %offset, align 8\n")
    compiler_output_string(output, "  store i64 %capacity, ptr %cap, align 8\n")
    compiler_output_string(output, "  ret void\n")
    compiler_output_string(output, "}\n")
    compiler_output_string(output, "define ptr @gsl.arena.alloc(ptr %arena, i64 %size) #0 {\n")
    compiler_output_string(output, "entry:\n")
    compiler_output_string(output, "  %offset_ptr = getelementptr %gsl.arena, ptr %arena, i32 0, i32 1\n")
    compiler_output_string(output, "  %capacity_ptr = getelementptr %gsl.arena, ptr %arena, i32 0, i32 2\n")
    compiler_output_string(output, "  %offset = load i64, ptr %offset_ptr, align 8\n")
    compiler_output_string(output, "  %capacity = load i64, ptr %capacity_ptr, align 8\n")
    compiler_output_string(output, "  %offset_valid = icmp ule i64 %offset, %capacity\n")
    compiler_output_string(output, "  br i1 %offset_valid, label %align, label %trap\n")
    compiler_output_string(output, "align:\n")
    compiler_output_string(output, "  %added = add i64 %offset, 7\n")
    compiler_output_string(output, "  %aligned = and i64 %added, -8\n")
    compiler_output_string(output, "  %no_wrap = icmp uge i64 %aligned, %offset\n")
    compiler_output_string(output, "  %aligned_fits = icmp ule i64 %aligned, %capacity\n")
    compiler_output_string(output, "  %alignment_valid = and i1 %no_wrap, %aligned_fits\n")
    compiler_output_string(output, "  br i1 %alignment_valid, label %check, label %trap\n")
    compiler_output_string(output, "check:\n")
    compiler_output_string(output, "  %remaining = sub i64 %capacity, %aligned\n")
    compiler_output_string(output, "  %fits = icmp ule i64 %size, %remaining\n")
    compiler_output_string(output, "  br i1 %fits, label %ok, label %trap\n")
    compiler_output_string(output, "trap:\n")
    compiler_output_string(output, "  call void @llvm.trap()\n")
    compiler_output_string(output, "  unreachable\n")
    compiler_output_string(output, "ok:\n")
    compiler_output_string(output, "  %base_ptr = getelementptr %gsl.arena, ptr %arena, i32 0, i32 0\n")
    compiler_output_string(output, "  %base = load ptr, ptr %base_ptr, align 8\n")
    compiler_output_string(output, "  %result = getelementptr i8, ptr %base, i64 %aligned\n")
    compiler_output_string(output, "  %next = add i64 %aligned, %size\n")
    compiler_output_string(output, "  store i64 %next, ptr %offset_ptr, align 8\n")
    compiler_output_string(output, "  ret ptr %result\n")
    compiler_output_string(output, "}\n")
}

