import "compiler/codegen_text"
import "compiler/intrinsics"
import "compiler/names"
import "compiler/types"
import "compiler/type_layout"
import "compiler/ir_storage"

const CODEGEN_LOCAL_POOL: usize = 4096


struct Codegen {
    function: *IrFunction,
    arguments: *CompilerPool,
    names: CompilerNames,
    next_reg: u32,
    next_label: u32,
    param_start: u32,
    param_count: u32,
    return_type: u32,
    return_signed: bool,
    locals: CompilerPool,
    local_count: u32,
    capture_call: u32,
    replay_call: u32,
    error: bool
}

struct CodegenLocal {
    name_id: u32,
    previous_binding: u32,
    name_ptr: *u8,
    name_len: usize,
    value_reg: u32,
    type_id: u32,
    is_signed: bool,
    is_mut: bool
}

// Callers use a bound index, or a slot reserved by codegen_bind.
func codegen_local(ctx: *Codegen, index: u32) *CodegenLocal {
    unsafe { return compiler_pool_item_ptr(&ctx.locals, index, size_of(CodegenLocal)) as *CodegenLocal }
}

func codegen_bind(ctx: *Codegen, name_ptr: *u8, name_len: usize, value_reg: u32, type_id: u32, is_signed: bool, is_mut: bool) {
    if compiler_pool_ensure(&ctx.locals, ctx.local_count, size_of(CodegenLocal), CODEGEN_LOCAL_POOL) == false {
        ctx.error = true
        return
    }
    let name_id = compiler_name_intern(&ctx.names, name_ptr, name_len)
    if name_id == INVALID_INDEX { ctx.error = true; return }
    let entry = compiler_name_record(&ctx.names, name_id)
    let local = codegen_local(ctx, ctx.local_count)
    local.name_id = name_id
    local.previous_binding = entry.binding
    entry.binding = ctx.local_count
    // Names borrow the parser source buffer, which outlives the local table.
    unsafe { local.name_ptr = name_ptr }
    local.name_len = name_len
    local.value_reg = value_reg
    local.type_id = type_id
    local.is_signed = is_signed
    local.is_mut = is_mut
    ctx.local_count += 1
}

func codegen_find_local(ctx: *Codegen, name_ptr: *u8, name_len: usize) u32 {
    let name_id = compiler_name_find(&ctx.names, name_ptr, name_len, compiler_name_hash(name_ptr, name_len))
    if name_id == INVALID_INDEX { return INVALID_INDEX }
    return compiler_name_record(&ctx.names, name_id).binding
}

func codegen_restore_locals(ctx: *Codegen, count: u32) {
    while ctx.local_count > count {
        ctx.local_count -= 1
        let local = codegen_local(ctx, ctx.local_count)
        compiler_name_record(&ctx.names, local.name_id).binding = local.previous_binding
    }
}









func codegen_index_array(p: *Parser, expr_idx: u32, ctx: *Codegen) u32 {
    let node = parser_expr(p, expr_idx)
    var base = codegen_expr_type(p, node.binary.left_idx, ctx, 0)
    if type_kind(p, base) == TYPE_POINTER { base = type_dereference(p, base) }
    if type_is_array(p, base) { return base }
    return 0
}





func codegen_builtin(p: *Parser, expr_idx: u32) u32 {
    let node = parser_expr(p, expr_idx)
    if node.call.callee_expr_idx != INVALID_INDEX {
        let callee = parser_expr(p, node.call.callee_expr_idx)
        if callee.kind == EXPR_MEMBER && compiler_name_is(callee.member.name_ptr, callee.member.name_len, "alloc") { return BUILTIN_ARENA_ALLOC }
        return BUILTIN_NONE
    }
    return compiler_intrinsic(node.call.callee_ptr, node.call.callee_len)
}

func codegen_natural_type(p: *Parser, expr_idx: u32, ctx: *Codegen) u32 {
    let type_id = codegen_expr_type(p, expr_idx, ctx, 0)
    if type_id != 0 { return type_id }
    return codegen_expr_type(p, expr_idx, ctx, 32)
}

func codegen_find_constant(p: *Parser, name: *u8, length: usize) u32 {
    var index: u32 = 0
    while index < p.const_count {
        let constant = parser_const(p, index)
        if parser_type_equal(constant.name_ptr, constant.name_len, name, length) { return index }
        index += 1
    }
    return INVALID_INDEX
}

func codegen_find_global(p: *Parser, name: *u8, length: usize) u32 {
    let index = codegen_find_constant(p, name, length)
    if index != INVALID_INDEX && parser_const(p, index).is_global { return index }
    return INVALID_INDEX
}

func codegen_section_valid(p: *Parser, index: u32) bool {
    if index == INVALID_INDEX { return true }
    let value = parser_expr(p, index)
    var offset = value.span.start + 1 as usize
    let end = value.span.end - 1 as usize
    if offset == end { return false }
    while offset < end {
        let ch = codegen_source_byte(p, offset)
        if (ch < 65 as u8 || ch > 90 as u8) && (ch < 97 as u8 || ch > 122 as u8) && (ch < 48 as u8 || ch > 57 as u8) && ch != 46 as u8 && ch != 95 as u8 && ch != 45 as u8 { return false }
        offset += 1 as usize
    }
    return true
}

func codegen_capacity(p: *Parser, expr_idx: u32) u32 {
    let node = parser_expr(p, expr_idx)
    if node.kind == EXPR_INT {
        let value = codegen_parse_integer(p, expr_idx)
        if value.valid == false || value.value > CODEGEN_MAX_LAYOUT as u64 { return 0 }
        return value.value as u32
    }
    if node.kind == EXPR_IDENT {
        let index = codegen_expr_constant(p, expr_idx)
        if index != INVALID_INDEX {
            let constant = parser_const(p, index)
            if constant.is_global == false { return codegen_capacity(p, constant.value_idx) }
        }
    }
    return 0
}

func codegen_member_field(p: *Parser, expr_idx: u32, ctx: *Codegen) u32 {
    let node = parser_expr(p, expr_idx)
    if node.resolved.field != INVALID_INDEX { return node.resolved.field }
    var type_id = codegen_expr_type(p, node.member.base_idx, ctx, 0)
    if type_kind(p, type_id) == TYPE_POINTER { type_id = type_dereference(p, type_id) }
    if type_kind(p, type_id) != TYPE_AGGREGATE { return INVALID_INDEX }
    let structure = parser_struct(p, type_declaration(p, type_id))
    var index = structure.field_start
    while index < structure.field_start + structure.field_count {
        let field = parser_field(p, index)
        if parser_type_equal(field.name_ptr, field.name_len, node.member.name_ptr, node.member.name_len) { node.resolved.field = index; return index }
        index += 1
    }
    return INVALID_INDEX
}

func codegen_write_type(p: *Parser, output: *CompilerOutput, type_id: u32) {
    if type_id == 0 { compiler_output_string(output, "void"); return }
    if type_is_pointer(p, type_id) { compiler_output_string(output, "ptr"); return }
    if type_kind(p, type_id) == TYPE_AGGREGATE {
        let structure = parser_struct(p, type_declaration(p, type_id))
        if structure.is_array {
            compiler_output_string(output, "[")
            codegen_write_u32(output, structure.array_count)
            compiler_output_string(output, " x ")
            codegen_write_type(p, output, resolved_type(p, structure.element_ptr, structure.element_len))
            compiler_output_string(output, "]")
        } else {
            compiler_output_string(output, "%struct.")
            codegen_write_token(p, output, structure.name_ptr, structure.name_len)
        }
        return
    }
    compiler_output_string(output, "i")
    codegen_write_u32(output, type_id)
}

func codegen_find_decl(p: *Parser, name_ptr: *u8, name_len: usize) u32 {
    var index: u32 = 0
    while index < p.decl_count {
        let decl = parser_decl(p, index)
        if parser_type_equal(name_ptr, name_len, decl.name_ptr, decl.name_len) { return index }
        index += 1
    }
    return INVALID_INDEX
}

func codegen_expr_local(p: *Parser, expr_idx: u32, ctx: *Codegen) u32 {
    let node = parser_expr(p, expr_idx)
    if node.resolved.binding_kind == BINDING_LOCAL { return parser_stmt(p, node.resolved.binding_index).resolved_local }
    if node.resolved.binding_kind == BINDING_PARAMETER { return node.resolved.binding_index - ctx.param_start }
    if node.resolved.binding_kind == BINDING_GLOBAL { return INVALID_INDEX }
    if node.resolved.local_index == INVALID_INDEX {
        let index = codegen_find_local(ctx, node.ident.name_ptr, node.ident.name_len)
        node.resolved.local_index = index
        if index == INVALID_INDEX { node.resolved.local_index = RESOLUTION_MISSING_LOCAL }
    }
    if node.resolved.local_index == RESOLUTION_MISSING_LOCAL { return INVALID_INDEX }
    return node.resolved.local_index
}

func codegen_expr_constant(p: *Parser, expr_idx: u32) u32 {
    let node = parser_expr(p, expr_idx)
    if node.resolved.binding_kind == BINDING_GLOBAL { return node.resolved.binding_index }
    return codegen_find_constant(p, node.ident.name_ptr, node.ident.name_len)
}

func codegen_expr_global(p: *Parser, expr_idx: u32) u32 {
    let index = codegen_expr_constant(p, expr_idx)
    if index != INVALID_INDEX && parser_const(p, index).is_global { return index }
    return INVALID_INDEX
}

func codegen_call_decl(p: *Parser, expr_idx: u32) u32 {
    let node = parser_expr(p, expr_idx)
    if node.resolved.declaration == INVALID_INDEX {
        node.resolved.declaration = codegen_find_decl(p, node.call.callee_ptr, node.call.callee_len)
    }
    return node.resolved.declaration
}

func codegen_expr_type(p: *Parser, expr_idx: u32, ctx: *Codegen, expected: u32) u32 {
    let node = parser_expr(p, expr_idx)
    // Literals and unary operators retain the existing contextual conversion rules.
    if node.kind == EXPR_INT || node.kind == EXPR_UNARY { return codegen_resolve_expr_type(p, expr_idx, ctx, expected) }
    if node.resolved.natural_type == INVALID_INDEX {
        node.resolved.natural_type = codegen_resolve_expr_type(p, expr_idx, ctx, 0)
    }
    if node.kind == EXPR_BINARY && node.resolved.natural_type == 0 { return expected }
    return node.resolved.natural_type
}

func codegen_resolve_expr_type(p: *Parser, expr_idx: u32, ctx: *Codegen, expected: u32) u32 {
    let node = parser_expr(p, expr_idx)
    if node.kind == EXPR_BOOL { return 1 }
    if node.kind == EXPR_STRING { return CODEGEN_STRING }
    if node.kind == EXPR_INDEX {
        let array_id = codegen_index_array(p, expr_idx, ctx)
        if array_id == 0 { return 0 }
        let array_type = parser_struct(p, type_declaration(p, array_id))
        return resolved_type(p, array_type.element_ptr, array_type.element_len)
    }
    if node.kind == EXPR_UNARY {
        if node.unary.op == TOKEN_NOT { return 1 }
        let operand_type = codegen_expr_type(p, node.unary.operand_idx, ctx, expected)
        if node.unary.op == TOKEN_AMP {
            return type_pointer_from_lowering(p, operand_type, codegen_expr_signed(p, node.unary.operand_idx, ctx, false))
        }
        if node.unary.op == TOKEN_STAR {
            if type_kind(p, operand_type) != TYPE_POINTER { return 0 }
            return type_dereference(p, operand_type)
        }
        return operand_type
    }
    if node.kind == EXPR_MEMBER {
        let field_idx = codegen_member_field(p, expr_idx, ctx)
        if field_idx == INVALID_INDEX { return 0 }
        let field = parser_field(p, field_idx)
        return resolved_type(p, field.type_ptr, field.type_len)
    }
    if node.kind == EXPR_INT {
        if expected == 0 && (node.int_lit.val as u64) > CODEGEN_MAX_LAYOUT as u64 { return 64 }
        return expected
    }
    if node.kind == EXPR_CAST { return resolved_type(p, node.cast.type_ptr, node.cast.type_len) }
    if node.kind == EXPR_BINARY {
        let op = node.binary.op
        if op == TOKEN_EQ || op == TOKEN_NE || op == TOKEN_LT || op == TOKEN_LE || op == TOKEN_GT || op == TOKEN_GE || op == TOKEN_AND || op == TOKEN_OR { return 1 }
        let left = codegen_expr_type(p, node.binary.left_idx, ctx, 0)
        let right = codegen_expr_type(p, node.binary.right_idx, ctx, 0)
        if left == 0 && right == 0 { return expected }
        if left != 0 { return left }
        return right
    }
    if node.kind == EXPR_IDENT {
        let local_idx = codegen_expr_local(p, expr_idx, ctx)
        if local_idx != INVALID_INDEX { return codegen_local(ctx, local_idx).type_id }
        var param_idx = ctx.param_start
        while param_idx < ctx.param_start + ctx.param_count {
            let param = parser_param(p, param_idx)
            if parser_type_equal(node.ident.name_ptr, node.ident.name_len, param.name_ptr, param.name_len) { return resolved_type(p, param.type_ptr, param.type_len) }
            param_idx += 1
        }
        let const_idx = codegen_expr_constant(p, expr_idx)
        if const_idx != INVALID_INDEX {
            let constant = parser_const(p, const_idx)
            if constant.type_len == 0 as usize {
                let value = parser_expr(p, constant.value_idx)
                if value.kind == EXPR_BOOL { return 1 }
                if (value.int_lit.val as u64) > CODEGEN_MAX_LAYOUT as u64 { return 64 }
                return 32
            }
            return resolved_type(p, constant.type_ptr, constant.type_len)
        }
        return 0
    }
    if node.kind == EXPR_CALL {
        let builtin = codegen_builtin(p, expr_idx)
        if builtin == BUILTIN_INB { return 8 }
        if builtin == BUILTIN_INW { return 16 }
        if builtin == BUILTIN_SYMBOL_ADDRESS || builtin == BUILTIN_READ_CR2 || builtin == BUILTIN_READ_CR3 || builtin == BUILTIN_ASM_U64 { return 64 }
        if builtin >= BUILTIN_OUTB { return 0 }
        if builtin == BUILTIN_SIZE_OF || builtin == BUILTIN_ALIGN_OF { return 64 }
        if builtin == BUILTIN_VOLATILE_READ { return 8 }
        if builtin == BUILTIN_VOLATILE_WRITE { return 0 }
        if builtin == BUILTIN_ARENA_ALLOC { return type_pointer_from_lowering(p, 8, false) }
        if builtin == BUILTIN_SYSCALL || builtin == BUILTIN_SYSCALL_WRITE { return 64 }
        let decl_idx = codegen_call_decl(p, expr_idx)
        if decl_idx != INVALID_INDEX {
            let decl = parser_decl(p, decl_idx)
            return resolved_type(p, decl.ret_type_ptr, decl.ret_type_len)
        }
    }
    return expected
}

func codegen_expr_signed(p: *Parser, expr_idx: u32, ctx: *Codegen, expected: bool) bool {
    let node = parser_expr(p, expr_idx)
    var valid = RESOLUTION_SIGNED_FALSE_VALID
    var value = RESOLUTION_SIGNED_FALSE_VALUE
    if expected { valid = RESOLUTION_SIGNED_TRUE_VALID; value = RESOLUTION_SIGNED_TRUE_VALUE }
    if (node.resolved.signedness & valid) == 0 {
        let result = codegen_resolve_expr_signed(p, expr_idx, ctx, expected)
        node.resolved.signedness = node.resolved.signedness | valid
        if result { node.resolved.signedness = node.resolved.signedness | value }
    }
    return (node.resolved.signedness & value) != 0
}

func codegen_resolve_expr_signed(p: *Parser, expr_idx: u32, ctx: *Codegen, expected: bool) bool {
    let node = parser_expr(p, expr_idx)
    if node.kind == EXPR_INT { return expected }
    if node.kind == EXPR_BOOL || node.kind == EXPR_STRING { return false }
    if node.kind == EXPR_INDEX {
        let array_id = codegen_index_array(p, expr_idx, ctx)
        if array_id == 0 { return false }
        let array_type = parser_struct(p, type_declaration(p, array_id))
        return type_is_signed(array_type.element_ptr, array_type.element_len)
    }
    if node.kind == EXPR_MEMBER {
        let field_idx = codegen_member_field(p, expr_idx, ctx)
        if field_idx == INVALID_INDEX { return false }
        let field = parser_field(p, field_idx)
        return type_is_signed(field.type_ptr, field.type_len)
    }
    if node.kind == EXPR_CAST { return type_is_signed(node.cast.type_ptr, node.cast.type_len) }
    if node.kind == EXPR_UNARY {
        if node.unary.op == TOKEN_NOT { return false }
        if node.unary.op == TOKEN_AMP { return false }
        if node.unary.op == TOKEN_STAR {
            return type_pointer_signed(p, codegen_expr_type(p, node.unary.operand_idx, ctx, 0))
        }
        return codegen_expr_signed(p, node.unary.operand_idx, ctx, expected)
    }
    if node.kind == EXPR_BINARY {
        let op = node.binary.op
        if op == TOKEN_EQ || op == TOKEN_NE || op == TOKEN_LT || op == TOKEN_LE || op == TOKEN_GT || op == TOKEN_GE || op == TOKEN_AND || op == TOKEN_OR { return false }
        return codegen_operand_signed(p, node.binary.left_idx, node.binary.right_idx, ctx, expected)
    }
    if node.kind == EXPR_IDENT {
        let local_idx = codegen_expr_local(p, expr_idx, ctx)
        if local_idx != INVALID_INDEX { return codegen_local(ctx, local_idx).is_signed }
        var param_idx = ctx.param_start
        while param_idx < ctx.param_start + ctx.param_count {
            let param = parser_param(p, param_idx)
            if parser_type_equal(node.ident.name_ptr, node.ident.name_len, param.name_ptr, param.name_len) { return type_is_signed(param.type_ptr, param.type_len) }
            param_idx += 1
        }
        let const_idx = codegen_expr_constant(p, expr_idx)
        if const_idx != INVALID_INDEX {
            let constant = parser_const(p, const_idx)
            return type_is_signed(constant.type_ptr, constant.type_len)
        }
    }
    if node.kind == EXPR_CALL {
        let builtin = codegen_builtin(p, expr_idx)
        if builtin == BUILTIN_SYSCALL || builtin == BUILTIN_SYSCALL_WRITE { return true }
        if builtin != BUILTIN_NONE { return false }
        let decl = parser_decl(p, codegen_call_decl(p, expr_idx))
        return type_is_signed(decl.ret_type_ptr, decl.ret_type_len)
    }
    return expected
}

func codegen_operand_type(p: *Parser, left_idx: u32, right_idx: u32, ctx: *Codegen, expected: u32) u32 {
    let left = codegen_expr_type(p, left_idx, ctx, 0)
    if left != 0 { return left }
    let right = codegen_expr_type(p, right_idx, ctx, 0)
    if right != 0 { return right }
    return expected
}

func codegen_operand_signed(p: *Parser, left_idx: u32, right_idx: u32, ctx: *Codegen, expected: bool) bool {
    if codegen_expr_type(p, left_idx, ctx, 0) != 0 { return codegen_expr_signed(p, left_idx, ctx, false) }
    if codegen_expr_type(p, right_idx, ctx, 0) != 0 { return codegen_expr_signed(p, right_idx, ctx, false) }
    return expected
}

func codegen_addressable(p: *Parser, expr_idx: u32, ctx: *Codegen) bool {
    let node = parser_expr(p, expr_idx)
    if node.kind == EXPR_IDENT { return codegen_expr_local(p, expr_idx, ctx) != INVALID_INDEX || codegen_expr_global(p, expr_idx) != INVALID_INDEX }
    if node.kind == EXPR_INDEX { return true }
    if node.kind == EXPR_UNARY { return node.unary.op == TOKEN_STAR }
    if node.kind == EXPR_MEMBER {
        if type_kind(p, codegen_expr_type(p, node.member.base_idx, ctx, 0)) == TYPE_POINTER { return true }
        return codegen_addressable(p, node.member.base_idx, ctx)
    }
    return false
}

func codegen_writable(p: *Parser, expr_idx: u32, ctx: *Codegen) bool {
    let node = parser_expr(p, expr_idx)
    if node.kind == EXPR_IDENT {
        let index = codegen_expr_local(p, expr_idx, ctx)
        if index == INVALID_INDEX { return codegen_expr_global(p, expr_idx) != INVALID_INDEX }
        return codegen_local(ctx, index).is_mut
    }
    if node.kind == EXPR_UNARY { return node.unary.op == TOKEN_STAR && type_is_pointer(p, codegen_expr_type(p, node.unary.operand_idx, ctx, 0)) }
    if node.kind == EXPR_INDEX {
        if type_kind(p, codegen_expr_type(p, node.binary.left_idx, ctx, 0)) == TYPE_POINTER { return true }
        return codegen_writable(p, node.binary.left_idx, ctx)
    }
    if node.kind == EXPR_MEMBER {
        if type_kind(p, codegen_expr_type(p, node.member.base_idx, ctx, 0)) == TYPE_POINTER { return true }
        return codegen_writable(p, node.member.base_idx, ctx)
    }
    return false
}

func codegen_begin_result(output: *CompilerOutput, ctx: *Codegen) u32 {
    ctx.next_reg += 1
    compiler_output_string(output, "  ")
    codegen_write_reg(output, ctx.next_reg)
    return ctx.next_reg
}

func codegen_binary_kind(op: u32, is_signed: bool) u32 {
    if op == TOKEN_PLUS { return IR_ADD }
    if op == TOKEN_MINUS { return IR_SUB }
    if op == TOKEN_STAR { return IR_MUL }
    if op == TOKEN_SLASH {
        if is_signed { return IR_SDIV }
        return IR_UDIV
    }
    if op == TOKEN_PERCENT {
        if is_signed { return IR_SREM }
        return IR_UREM
    }
    if op == TOKEN_SHIFT_LEFT { return IR_SHL }
    if op == TOKEN_SHIFT_RIGHT {
        if is_signed { return IR_ASHR }
        return IR_LSHR
    }
    if op == TOKEN_AMP { return IR_AND }
    if op == TOKEN_BIT_OR { return IR_OR }
    if op == TOKEN_BIT_XOR { return IR_XOR }
    if op == TOKEN_EQ { return IR_EQ }
    if op == TOKEN_NE { return IR_NE }
    if op == TOKEN_LT {
        if is_signed { return IR_SLT }
        return IR_ULT
    }
    if op == TOKEN_LE {
        if is_signed { return IR_SLE }
        return IR_ULE
    }
    if op == TOKEN_GT {
        if is_signed { return IR_SGT }
        return IR_UGT
    }
    if op == TOKEN_GE {
        if is_signed { return IR_SGE }
        return IR_UGE
    }
    return IR_INVALID
}
