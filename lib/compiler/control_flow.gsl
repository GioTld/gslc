import "compiler/parser"

const FLOW_CONTINUES: u32 = 1
const FLOW_TERMINATES: u32 = 2

const FLOW_RETURN: u32 = 1
const FLOW_BREAK: u32 = 2
const FLOW_CONTINUE: u32 = 3
const FLOW_FALLTHROUGH: u32 = 4
const FLOW_MAX_ACTIVE_DEFERS: u32 = 64
const FLOW_RECORD_BYTES: usize = 4096

struct FlowCleanup {
    expression: u32,
    previous: u32
}

struct FlowExit {
    kind: u32,
    target: u32,
    cleanup_head: u32,
    cleanup_stop: u32
}

struct FlowContext {
    cleanup_head: u32,
    active_count: u32,
    loop_target: u32,
    loop_stop: u32,
    error: bool
}

func flow_cleanup(p: *Parser, index: u32) *FlowCleanup {
    unsafe { return compiler_pool_item_ptr(&p.flow_cleanups, index, size_of(FlowCleanup)) as *FlowCleanup }
}

func flow_exit(p: *Parser, index: u32) *FlowExit {
    unsafe { return compiler_pool_item_ptr(&p.flow_exits, index, size_of(FlowExit)) as *FlowExit }
}

func flow_add_exit(p: *Parser, context: *FlowContext, kind: u32, target: u32, stop: u32) u32 {
    let index = p.flow_exit_count
    if compiler_pool_ensure(&p.flow_exits, index, size_of(FlowExit), FLOW_RECORD_BYTES) == false { context.error = true; return INVALID_INDEX }
    let edge = flow_exit(p, index)
    edge.kind = kind
    edge.target = target
    edge.cleanup_head = context.cleanup_head
    edge.cleanup_stop = stop
    p.flow_exit_count += 1
    return index
}

// The syntax tree is immutable during analysis; scope exits share this predicate.
func flow_statement_terminates(p: *Parser, index: u32) bool {
    let statement = parser_stmt(p, index)
    if statement.flow_termination != 0 { return statement.flow_termination == FLOW_TERMINATES }
    var terminates = statement.kind == STMT_RETURN || statement.kind == STMT_BREAK || statement.kind == STMT_CONTINUE
    if statement.kind == STMT_UNSAFE { terminates = flow_block_terminates(p, statement.block.body_start, statement.block.body_count) }
    if statement.kind == STMT_IF {
        terminates = flow_block_terminates(p, statement.block.body_start, statement.block.body_count) && flow_block_terminates(p, statement.block.else_start, statement.block.else_count)
    }
    statement.flow_termination = FLOW_CONTINUES
    if terminates { statement.flow_termination = FLOW_TERMINATES }
    return terminates
}

func flow_block_terminates(p: *Parser, start: u32, count: u32) bool {
    var index = start
    var visited: u32 = 0
    while index != INVALID_INDEX && visited < count {
        if flow_statement_terminates(p, index) { return true }
        index = parser_stmt(p, index).next_idx
        visited += 1
    }
    return false
}

// Cleanup lists are persistent: sibling branches share their incoming prefix.
func flow_plan_block(p: *Parser, start: u32, count: u32, context: *FlowContext) bool {
    let saved_head = context.cleanup_head
    let saved_count = context.active_count
    var index = start
    var visited: u32 = 0
    var terminated = false
    while index != INVALID_INDEX && visited < count && context.error == false {
        let statement = parser_stmt(p, index)
        if statement.kind == STMT_DEFER {
            if context.active_count == FLOW_MAX_ACTIVE_DEFERS { context.error = true; break }
            let cleanup = p.flow_cleanup_count
            if compiler_pool_ensure(&p.flow_cleanups, cleanup, size_of(FlowCleanup), FLOW_RECORD_BYTES) == false { context.error = true; break }
            let action = flow_cleanup(p, cleanup)
            action.expression = statement.expr_idx
            action.previous = context.cleanup_head
            context.cleanup_head = cleanup
            context.active_count += 1
            p.flow_cleanup_count += 1
        } else if statement.kind == STMT_RETURN {
            statement.flow_exit = flow_add_exit(p, context, FLOW_RETURN, INVALID_INDEX, INVALID_INDEX)
        } else if statement.kind == STMT_BREAK || statement.kind == STMT_CONTINUE {
            if context.loop_target == INVALID_INDEX { context.error = true; break }
            var kind = FLOW_BREAK
            if statement.kind == STMT_CONTINUE { kind = FLOW_CONTINUE }
            statement.flow_exit = flow_add_exit(p, context, kind, context.loop_target, context.loop_stop)
        } else if statement.kind == STMT_IF {
            flow_plan_block(p, statement.block.body_start, statement.block.body_count, context)
            flow_plan_block(p, statement.block.else_start, statement.block.else_count, context)
        } else if statement.kind == STMT_UNSAFE {
            flow_plan_block(p, statement.block.body_start, statement.block.body_count, context)
        } else if statement.kind == STMT_WHILE {
            let old_target = context.loop_target
            let old_stop = context.loop_stop
            context.loop_target = index
            context.loop_stop = context.cleanup_head
            flow_plan_block(p, statement.block.body_start, statement.block.body_count, context)
            context.loop_target = old_target
            context.loop_stop = old_stop
        }
        terminated = flow_statement_terminates(p, index)
        if terminated { break }
        index = statement.next_idx
        visited += 1
    }
    if terminated == false && start != INVALID_INDEX && context.error == false {
        parser_stmt(p, start).flow_block_exit = flow_add_exit(p, context, FLOW_FALLTHROUGH, INVALID_INDEX, saved_head)
    }
    context.cleanup_head = saved_head
    context.active_count = saved_count
    return terminated
}

func flow_plan(p: *Parser) bool {
    p.flow_exit_count = 0
    p.flow_cleanup_count = 0
    var context: FlowContext
    context.cleanup_head = INVALID_INDEX
    context.active_count = 0
    context.loop_target = INVALID_INDEX
    context.loop_stop = INVALID_INDEX
    context.error = false
    var index: u32 = 0
    while index < p.decl_count && context.error == false {
        let function = parser_decl(p, index)
        function.flow_returns = flow_plan_block(p, function.body_start, function.body_count, &context)
        index += 1
    }
    return context.error == false
}
