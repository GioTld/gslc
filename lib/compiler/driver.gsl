import "compiler/host_linux"
import "compiler/token"
import "compiler/lexer"
import "compiler/ast"
import "compiler/parser"
import "compiler/sema"
import "compiler/codegen"
import "compiler/imports"
import "std/file"
import "std/io"

const COMPILER_OUTPUT_MODE: u64 = 420

func compile_string(src: string, out_path: string) u32 {
    return compile_string_mode(src, out_path, false)
}

func compiler_print_diagnostic(code: u32, start: usize, end: usize, message: string) {
    var output: CompilerOutput
    output.fd = 1
    output.error = false
    io_print("{\"code\":\"E")
    codegen_write_u32(&output, code)
    io_print("\",\"span\":{\"start\":")
    codegen_write_u64(&output, start as u64)
    io_print(",\"end\":")
    codegen_write_u64(&output, end as u64)
    io_print("},\"message\":\"")
    io_print(message)
    io_println("\"}")
}

func compiler_error_offset(p: *Parser, line: u32, col: u32) usize {
    var offset: usize = 0 as usize
    var current_line: u32 = 1
    var current_col: u32 = 1
    while current_line < line || current_col < col {
        let ch = codegen_source_byte(p, offset)
        if ch == 0 as u8 { return offset }
        if ch == 10 as u8 { current_line += 1; current_col = 1; } else { current_col += 1; }
        offset += 1 as usize
    }
    return offset
}

func compiler_semantic_message(code: u32) string {
    if code == 2001 { return "undefined identifier" }
    if code == 2002 { return "argument count mismatch" }
    if code == 2003 { return "immutable binding" }
    if code == 2004 { return "unsafe operation" }
    if code == 2005 { return "use of moved value" }
    if code == 2006 { return "copy struct contains non-copy field" }
    if code == 2007 { return "move from outer scope inside loop" }
    if code == 2008 { return "non-copy value from borrowed storage requires unsafe" }
    if code == 2009 { return "move of borrowed value" }
    if code == 2010 { return "reference escapes its storage scope" }
    if code == 2011 { return "reference store through pointer requires unsafe" }
    return "semantic error"
}

func compiler_print_semantic(p: *Parser, s: *Sema, combined: bool) {
    var output: CompilerOutput
    output.fd = 1
    output.error = false
    io_print("gslc-self: E")
    codegen_write_u32(&output, s.error_code)
    io_print(": ")
    io_print(compiler_semantic_message(s.error_code))
    var line = s.error_line
    var column = s.error_col
    if s.error_end > s.error_start {
        line = 1
        column = 1
        var offset: usize = 0 as usize
        while offset < s.error_start {
            if codegen_source_byte(p, offset) == 10 as u8 { line += 1; column = 1; } else { column += 1; }
            offset += 1 as usize
        }
    }
    if line != 0 && column != 0 {
        if combined { io_print(" at combined source ") } else { io_print(" at ") }
        codegen_write_u32(&output, line)
        io_print(":")
        codegen_write_u32(&output, column)
    }
    io_println("")
}

func compile_string_mode(src: string, out_path: string, machine: bool) u32 {
    return compile_string_profile(src, out_path, machine, false)
}

func compile_string_profile(src: string, out_path: string, machine: bool, kernel: bool) u32 {
    return compiler_compile_source(src, out_path, machine, kernel, false)
}

func compiler_compile_source(src: string, out_path: string, machine: bool, kernel: bool, combined: bool) u32 {
    arena work(6553600)

    var p: Parser
    var s: Sema

    let storage = work.alloc((PARSER_MAX_EXPRS as usize) * size_of(Expr) + (PARSER_MAX_STMTS as usize) * size_of(Stmt) + (PARSER_MAX_PARAMS as usize) * size_of(Param) + (PARSER_MAX_DECLS as usize) * size_of(FuncDecl) + (PARSER_MAX_CONSTS as usize) * size_of(CompilerConst) + (PARSER_MAX_STRUCTS as usize) * size_of(CompilerStruct) + (PARSER_MAX_FIELDS as usize) * size_of(CompilerField))
    parser_init(&p, src, storage)
    parser_parse(&p)

    if p.error {
        if machine {
            let offset = compiler_error_offset(&p, p.error_line, p.error_col)
            compiler_print_diagnostic(1000, offset, offset, "syntax error")
            return 1
        }
        var output: CompilerOutput
        output.fd = 1
        output.error = false
        io_print("gslc-self: syntax error at ")
        codegen_write_u32(&output, p.error_line)
        io_print(":")
        codegen_write_u32(&output, p.error_col)
        io_println("")
        return 1
    }

    let symbols = work.alloc((SEMA_MAX_SYMBOLS as usize) * size_of(Symbol))
    sema_init(&s, symbols)
    s.kernel = kernel
    sema_check(&s, &p)

    if s.error {
        if machine {
            compiler_print_diagnostic(s.error_code, s.error_start, s.error_end, compiler_semantic_message(s.error_code))
            return 2
        }
        compiler_print_semantic(&p, &s, combined)
        return 2
    }

    if codegen_preflight(&p) == false {
        if machine { compiler_print_diagnostic(4000, 0 as usize, 0 as usize, "unsupported construct"); return 4; }
        io_println("gslc-self: unsupported construct")
        return 4
    }

    let status = compiler_emit_file(&p, out_path, kernel)
    if status == 3 {
        if machine { compiler_print_diagnostic(3001, 0 as usize, 0 as usize, "output error"); return 3; }
        io_println("gslc-self: failed to write output file")
        return 3
    }
    if status == 4 {
        if machine { compiler_print_diagnostic(4000, 0 as usize, 0 as usize, "unsupported construct"); return 4; }
        io_println("gslc-self: unsupported construct")
        return 4
    }

    if machine == false { io_println("gslc-self: LLVM IR generado exitosamente"); }
    return 0
}

func compile_file(src_path: string, out_path: string) u32 {
    return compile_file_mode(src_path, out_path, false)
}

func compile_file_mode(src_path: string, out_path: string, machine: bool) u32 {
    return compile_file_profile(src_path, out_path, machine, false)
}

func compile_file_profile(src_path: string, out_path: string, machine: bool, kernel: bool) u32 {
    return compile_file_options(src_path, out_path, machine, kernel, "", "", false)
}

func compile_file_options(src_path: string, out_path: string, machine: bool, kernel: bool, platform: string, root: string, list_sources: bool) u32 {
    let kind = compiler_platform_kind(platform, root, kernel)
    if kind == INVALID_INDEX { io_println("gslc-self: incompatible platform options"); return 64 }
    arena input(344072)
    var imports: ImportState
    imports.output = input.alloc(327681 as usize)
    imports.paths = input.alloc(16384 as usize)
    imports.used = 0 as usize
    imports.platform = kind
    unsafe { imports.platform_root = root }
    imports.path_count = 0
    let result = compiler_collect_file(src_path, &imports, 0)
    if result != 0 {
        if machine { compiler_print_diagnostic(3000, 0 as usize, 0 as usize, "input error"); return result; }
        if result == 10 { io_println("gslc-self: platform module unavailable"); return result }
        io_println("gslc-self: failed to load source closure")
        return result
    }
    if list_sources {
        var index: u32 = 0
        while index < imports.path_count {
            io_println(compiler_import_as_string(compiler_import_path_slot(&imports, index)))
            index += 1
        }
        return 0
    }
    return compiler_compile_source(compiler_import_as_string(imports.output), out_path, machine, kernel, imports.path_count > 1)
}

