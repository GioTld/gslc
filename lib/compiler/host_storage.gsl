import "platform/linux_x86_64/native"
import "core/mem"

const COMPILER_STORAGE_BLOCK_BYTES: usize = 65536
const COMPILER_STORAGE_PAGE_BYTES: usize = 4096
const COMPILER_STORAGE_HEADER_BYTES: usize = 24
const COMPILER_STORAGE_CAPACITY_OFFSET: usize = 8
const COMPILER_STORAGE_USED_OFFSET: usize = 16

struct CompilerContext {
    blocks: *usize,
    used_bytes: usize,
    mapped_bytes: usize,
    error: bool
}

func compiler_context_init(context: *CompilerContext) {
    unsafe { context.blocks = 0 as *usize }
    context.used_bytes = 0 as usize
    context.mapped_bytes = 0 as usize
    context.error = false
}

func compiler_context_release(context: *CompilerContext) {
    unsafe {
        var block = context.blocks
        while block as usize != 0 as usize {
            let next = (*block) as *usize
            let bytes = *((block as usize + COMPILER_STORAGE_CAPACITY_OFFSET) as *usize)
            linux_unmap(block as *u8, bytes)
            block = next
        }
    }
    compiler_context_init(context)
}

func compiler_storage_allocate(context: *CompilerContext, bytes: usize) *u8 {
    unsafe {
        if context.error || bytes > MEM_MAX_SIZE - 7 as usize { context.error = true; return 0 as *u8 }
        let rounded = (bytes + 7 as usize) & (MEM_MAX_SIZE - 7 as usize)
        if rounded > MEM_MAX_SIZE - context.used_bytes { context.error = true; return 0 as *u8 }
        var block = context.blocks
        if block as usize != 0 as usize {
            let capacity = *((block as usize + COMPILER_STORAGE_CAPACITY_OFFSET) as *usize)
            let used = ((block as usize + COMPILER_STORAGE_USED_OFFSET) as *usize)
            if rounded <= capacity - *used {
                let result = (block as usize + *used) as *u8
                *used = *used + rounded
                context.used_bytes += rounded
                return result
            }
        }
        if rounded > MEM_MAX_SIZE - COMPILER_STORAGE_HEADER_BYTES - COMPILER_STORAGE_PAGE_BYTES { context.error = true; return 0 as *u8 }
        var capacity = COMPILER_STORAGE_BLOCK_BYTES
        let required = rounded + COMPILER_STORAGE_HEADER_BYTES
        if required > capacity { capacity = (required + COMPILER_STORAGE_PAGE_BYTES - 1 as usize) & (MEM_MAX_SIZE - COMPILER_STORAGE_PAGE_BYTES + 1 as usize) }
        if capacity > MEM_MAX_SIZE - context.mapped_bytes { context.error = true; return 0 as *u8 }
        let memory = linux_map_storage(capacity)
        if memory as usize == 0 as usize { context.error = true; return memory }
        block = memory as *usize
        *block = context.blocks as usize
        *((memory as usize + COMPILER_STORAGE_CAPACITY_OFFSET) as *usize) = capacity
        *((memory as usize + COMPILER_STORAGE_USED_OFFSET) as *usize) = COMPILER_STORAGE_HEADER_BYTES + rounded
        context.blocks = block
        context.mapped_bytes += capacity
        context.used_bytes += rounded
        return (memory as usize + COMPILER_STORAGE_HEADER_BYTES) as *u8
    }
}

const COMPILER_POOL_DIRECTORY_INITIAL: usize = 16
const COMPILER_POOL_INVALID_INDEX: u32 = 4294967295

struct CompilerPool {
    context: *CompilerContext,
    directory: *usize,
    directory_capacity: usize,
    block_count: u32,
    items_per_block: usize,
    item_size: usize
}

func compiler_pool_init(pool: *CompilerPool, context: *CompilerContext) {
    unsafe { pool.context = context }
    unsafe { pool.directory = 0 as *usize }
    pool.directory_capacity = 0 as usize
    pool.block_count = 0
    pool.items_per_block = 0 as usize
    pool.item_size = 0 as usize
}

// Directory growth moves only pointers. Records remain at stable addresses.
func compiler_pool_directory_grow(pool: *CompilerPool) bool {
    var capacity = COMPILER_POOL_DIRECTORY_INITIAL
    if pool.directory_capacity != 0 as usize {
        if pool.directory_capacity > MEM_MAX_SIZE / (2 as usize * size_of(usize)) { return false }
        capacity = pool.directory_capacity * 2 as usize
    }
    let memory = compiler_storage_allocate(pool.context, capacity * size_of(usize))
    if (memory as usize) == 0 as usize { return false }
    unsafe {
        var index: usize = 0 as usize
        while index < pool.block_count as usize {
            let old_slot = ((pool.directory as usize) + index * size_of(usize)) as *usize
            let new_slot = ((memory as usize) + index * size_of(usize)) as *usize
            *new_slot = *old_slot
            index += 1 as usize
        }
        pool.directory = memory as *usize
    }
    pool.directory_capacity = capacity
    return true
}

func compiler_pool_item_ptr(pool: *CompilerPool, index: u32, item_size: usize) *u8 {
    unsafe {
        if pool.items_per_block == 0 as usize || item_size != pool.item_size { return 0 as *u8 }
        let block = (index as usize) / pool.items_per_block
        if block >= pool.block_count as usize { return 0 as *u8 }
        let slot = ((pool.directory as usize) + block * size_of(usize)) as *usize
        let offset = ((index as usize) % pool.items_per_block) * item_size
        return (*slot + offset) as *u8
    }
}

func compiler_pool_ensure(pool: *CompilerPool, index: u32, item_size: usize, initial_bytes: usize) bool {
    if index == COMPILER_POOL_INVALID_INDEX || item_size == 0 as usize { return false }
    if pool.items_per_block == 0 as usize {
        pool.items_per_block = initial_bytes / item_size
        pool.item_size = item_size
        if pool.items_per_block == 0 as usize { return false }
    }
    if pool.item_size != item_size { return false }
    let block = (index as usize) / pool.items_per_block
    if block < pool.block_count as usize { return true }
    // Callers append slots or reuse an existing scope; sparse allocation is invalid.
    if block != pool.block_count as usize { return false }
    if block == pool.directory_capacity && compiler_pool_directory_grow(pool) == false { return false }
    let memory = compiler_storage_allocate(pool.context, pool.items_per_block * item_size)
    if (memory as usize) == 0 as usize { return false }
    unsafe {
        let slot = ((pool.directory as usize) + block * size_of(usize)) as *usize
        *slot = memory as usize
    }
    pool.block_count += 1
    return true
}
