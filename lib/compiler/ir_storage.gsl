func ir_append_arena_allocate(function: *IrFunction, operation: *IrArenaAllocate) {
    unsafe { ir_store(function, IR_INSTRUCTION_ARENA_ALLOCATE, operation as *u8, size_of(IrArenaAllocate)) }
