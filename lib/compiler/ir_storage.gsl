func ir_append_zero(function: *IrFunction, operation: *IrZero) {
    unsafe { ir_store(function, IR_INSTRUCTION_ZERO, operation as *u8, size_of(IrZero)) }
}

func ir_append_block(function: *IrFunction, kind: u32, label: u32) {
    var operation: IrBlock
    operation.kind = kind
    operation.label = label
    unsafe { ir_store(function, IR_INSTRUCTION_BLOCK, &operation as *u8, size_of(IrBlock)) }
}

func ir_append_jump(function: *IrFunction, kind: u32, label: u32) {
    var operation: IrBlock
    operation.kind = kind
    operation.label = label
    unsafe { ir_store(function, IR_INSTRUCTION_JUMP, &operation as *u8, size_of(IrBlock)) }
}
