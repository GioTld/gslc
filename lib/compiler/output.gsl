import "std/io"

struct CompilerOutput {
    fd: u64,
    error: bool
}

func compiler_output_write(output: *CompilerOutput, data: *u8, length: usize) {
    if output.error { return }
    var file: File
    file.handle = output.fd
    file.is_open = true
    let result = io_write_all(&file, data, length)
    if result.error != IO_OK { output.error = true }
}

func compiler_output_string(output: *CompilerOutput, value: string) {
    var bytes: *u8
    unsafe { bytes = value as *u8 }
    compiler_output_write(output, bytes, strlen(value) as usize)
}
