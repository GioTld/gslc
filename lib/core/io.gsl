func strlen(s: string) u64 {
    var len: u64 = 0
    unsafe {
        let ptr = (s as usize) as *u8
        while volatile_read(((ptr as usize) + (len as usize)) as *u8) != 0 as u8 {
            len += 1
        }
    }
    return len
}

func print_raw(msg: string, len: u64) {
    unsafe {
        syscall_write(1 as u64, msg, len)
    }
}

func print(msg: string) {
    let len = strlen(msg)
    unsafe {
        syscall_write(1 as u64, msg, len)
    }
}
