func memcpy(dst: *u8, src: *u8, count: usize) *u8 {
    var i: usize = 0
    while i < count {
        unsafe {
            let s_ptr = ((src as usize) + i) as *u8
            let d_ptr = ((dst as usize) + i) as *u8
            let b = volatile_read(s_ptr)
            volatile_write(d_ptr, b)
        }
        i += 1
    }
    return dst
}

func memset(dst: *u8, val: u8, count: usize) *u8 {
    var i: usize = 0
    while i < count {
        unsafe {
            let d_ptr = ((dst as usize) + i) as *u8
            volatile_write(d_ptr, val)
        }
        i += 1
    }
    return dst
}

func memmove(dst: *u8, src: *u8, count: usize) *u8 {
    if (dst as usize) <= (src as usize) { return memcpy(dst, src, count) }
    var i = count
    while i > 0 as usize {
        i -= 1 as usize
        unsafe {
            let value = volatile_read(((src as usize) + i) as *u8)
            volatile_write(((dst as usize) + i) as *u8, value)
        }
    }
    return dst
}

func memcmp(left: *u8, right: *u8, count: usize) i32 {
    var i: usize = 0
    while i < count {
        unsafe {
            let a = volatile_read(((left as usize) + i) as *u8)
            let b = volatile_read(((right as usize) + i) as *u8)
            if a != b { return (a as i32) - (b as i32) }
        }
        i += 1 as usize
    }
    return 0 as i32
}

func align_up(val: usize, alignment: usize) usize {
    if alignment <= 1 as usize { return val }
    let mask = alignment - (1 as usize)
    return (val + mask) & (0 as usize - alignment)
}

func align_down(val: usize, alignment: usize) usize {
    if alignment <= 1 as usize { return val }
    return val & (0 as usize - alignment)
}

func bswap16(val: u16) u16 {
    return ((val >> 8) | (val << 8)) as u16
}

func bswap32(val: u32) u32 {
    return ((val >> 24) | ((val & 16711680) >> 8) | ((val & 65280) << 8) | (val << 24)) as u32
}

func bswap64(val: u64) u64 {
    let low = bswap32((val & 4294967295) as u32) as u64
    let high = bswap32((val >> 32) as u32) as u64
    return (low << 32) | high
}

copy struct ByteView {
    data: *u8,
    len: usize
}

func byte_view(data: *u8, len: usize) ByteView {
    var v: ByteView
    v.data = data
    v.len = len
    return v
}

func byte_view_slice(v: ByteView, start: usize, len: usize) ByteView {
    unsafe {
        if start > v.len || len > v.len - start { return byte_view(0 as *u8, 0 as usize) }
        let sub = ((v.data as usize) + start) as *u8
        return byte_view(sub, len)
    }
}

const ALLOC_OK: u32 = 0
const ALLOC_ERR_OOM: u32 = 1
const ALLOC_ERR_ALIGN: u32 = 2
const ALLOC_ERR_OVERFLOW: u32 = 3
const MEM_MAX_SIZE: usize = 18446744073709551615

copy struct AllocResult {
    ptr: *u8,
    error: u32
}

func alloc_ok(ptr: *u8) AllocResult {
    var r: AllocResult
    r.ptr = ptr
    r.error = ALLOC_OK
    return r
}

func alloc_fail(err: u32) AllocResult {
    var r: AllocResult
    unsafe {
        r.ptr = 0 as *u8
    }
    r.error = err
    return r
}

struct Arena {
    buffer: *u8,
    capacity: usize,
    offset: usize
}

func arena_init(buffer: *u8, capacity: usize) Arena {
    var a: Arena
    a.buffer = buffer
    a.capacity = capacity
    a.offset = 0 as usize
    return a
}

func arena_alloc(a: *Arena, size: usize, alignment: usize) AllocResult {
    if alignment == 0 as usize || (alignment & (alignment - 1 as usize)) != 0 as usize { return alloc_fail(ALLOC_ERR_ALIGN) }
    let base = a.buffer as usize
    if a.offset > a.capacity { return alloc_fail(ALLOC_ERR_OOM) }
    if a.offset > MEM_MAX_SIZE - base { return alloc_fail(ALLOC_ERR_OVERFLOW) }
    let current = base + a.offset
    if alignment - 1 as usize > MEM_MAX_SIZE - current { return alloc_fail(ALLOC_ERR_OVERFLOW) }
    let aligned = align_up(current, alignment)
    let padding = aligned - current
    let remaining = a.capacity - a.offset
    if padding > remaining || size > remaining - padding { return alloc_fail(ALLOC_ERR_OOM) }
    if size > MEM_MAX_SIZE - aligned { return alloc_fail(ALLOC_ERR_OVERFLOW) }
    let new_offset = a.offset + padding + size
    a.offset = new_offset
    unsafe {
        return alloc_ok(aligned as *u8)
    }
}

func arena_reset(a: *Arena) {
    a.offset = 0 as usize
}

func arena_remaining(a: *Arena) usize {
    if a.offset >= a.capacity { return 0 as usize }
    return a.capacity - a.offset
}

struct Chunk {
    buffer: *u8,
    capacity: usize,
    offset: usize,
    next: *Chunk
}

struct ChunkArena {
    first: *Chunk,
    current: *Chunk,
    total_allocated: usize
}

func chunk_arena_init(a: *ChunkArena, initial: *Chunk, buffer: *u8, capacity: usize) {
    unsafe {
        initial.buffer = buffer
        initial.capacity = capacity
        initial.offset = 0 as usize
        initial.next = 0 as *Chunk
        a.first = initial
        a.current = initial
    }
    a.total_allocated = 0 as usize
}

func chunk_arena_alloc(a: *ChunkArena, size: usize, alignment: usize) AllocResult {
    if alignment == 0 as usize || (alignment & (alignment - 1 as usize)) != 0 as usize { return alloc_fail(ALLOC_ERR_ALIGN) }
    if size > MEM_MAX_SIZE - a.total_allocated { return alloc_fail(ALLOC_ERR_OVERFLOW) }
    var chunk = a.current
    while (chunk as usize) != 0 as usize {
        var view = arena_init(chunk.buffer, chunk.capacity)
        view.offset = chunk.offset
        let result = arena_alloc(&view, size, alignment)
        if result.error == ALLOC_OK {
            chunk.offset = view.offset
            unsafe { a.current = chunk }
            a.total_allocated += size
            unsafe { return result }
        }
        if result.error != ALLOC_ERR_OOM { return alloc_fail(result.error) }
        unsafe { chunk = chunk.next }
    }
    return alloc_fail(ALLOC_ERR_OOM)
}

func chunk_arena_append(a: *ChunkArena, new_chunk: *Chunk, buffer: *u8, capacity: usize) {
    unsafe {
        new_chunk.buffer = buffer
        new_chunk.capacity = capacity
        new_chunk.offset = 0 as usize
        new_chunk.next = 0 as *Chunk
        if (a.first as usize) == 0 {
            a.first = new_chunk
            a.current = new_chunk
            return
        }
        var tail = a.first
        while (tail.next as usize) != 0 {
            tail = tail.next
        }
        tail.next = new_chunk
        if a.current.offset >= a.current.capacity {
            a.current = new_chunk
        }
    }
}

func chunk_arena_init_empty(a: *ChunkArena) {
    unsafe {
        a.first = 0 as *Chunk
        a.current = 0 as *Chunk
    }
    a.total_allocated = 0 as usize
}

// Returns a pointer to item at index idx, given that each item is item_size bytes.
// All chunks in the arena must have the same capacity (items_per_chunk * item_size).
func chunk_arena_item_ptr(a: *ChunkArena, idx: u32, item_size: usize) *u8 {
    if item_size == 0 as usize { unsafe { return 0 as *u8 } }
    var chunk = a.first
    var remaining = idx as usize
    while (chunk as usize) != 0 {
        let items_in_chunk = chunk.capacity / item_size
        if remaining < items_in_chunk {
            unsafe { return ((chunk.buffer as usize) + remaining * item_size) as *u8 }
        }
        remaining -= items_in_chunk
        unsafe { chunk = chunk.next }
    }
    unsafe { return 0 as *u8 }
}
