import "core/io"

const O_RDONLY: u64 = 0
const O_WRONLY: u64 = 1
const O_RDWR: u64 = 2
const O_CREAT: u64 = 64
const O_TRUNC: u64 = 512

func open(path: string, flags: u64, mode: u64) i64 {
    unsafe {
        return syscall(2 as u64, (path as usize) as u64, flags, mode)
    }
}

func read(fd: u64, buf: *u8, count: usize) i64 {
    unsafe {
        return syscall(0 as u64, fd, (buf as usize) as u64, count as u64)
    }
}

func write(fd: u64, buf: *u8, count: usize) i64 {
    unsafe {
        return syscall(1 as u64, fd, (buf as usize) as u64, count as u64)
    }
}

func write_string(fd: u64, s: string) i64 {
    let len = strlen(s)
    unsafe {
        return syscall(1 as u64, fd, (s as usize) as u64, len)
    }
}

func close(fd: u64) i64 {
    unsafe {
        return syscall(3 as u64, fd, 0 as u64, 0 as u64)
    }
}
