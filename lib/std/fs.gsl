import "std/file"
import "std/io"

func fs_read_into(path: string, buffer: *u8, capacity: usize) IoResult {
    var opened = fs_open_read(path)
    if opened.error != IO_OK { return io_result(0 as usize, opened.error, false) }
    var result = io_result(0 as usize, IO_OK, false)
    while result.count < capacity && result.error == IO_OK && result.eof == false {
        var current: *u8
        unsafe { current = ((buffer as usize) + result.count) as *u8 }
        let part = io_read(&opened.file, current, capacity - result.count)
        if part.error != IO_INTERRUPTED {
            result.error = part.error
            result.eof = part.eof
            if part.count > capacity - result.count { result.error = IO_ERROR } else { result.count += part.count }
            if part.error == IO_OK && part.count == 0 as usize && part.eof == false { result.error = IO_ERROR }
        }
    }
    if result.error == IO_OK && result.eof == false {
        var extra: u8
        var probe = io_result(0 as usize, IO_INTERRUPTED, false)
        while probe.error == IO_INTERRUPTED { probe = io_read(&opened.file, &extra, 1 as usize) }
        result.error = probe.error
        result.eof = probe.eof
        if probe.error == IO_OK {
            if probe.count != 0 as usize { result.error = IO_BUFFER_SMALL } else if probe.eof == false { result.error = IO_ERROR }
        }
    }
    let closed = fs_close(&opened.file)
    if result.error == IO_OK { result.error = closed }
    return result
}
