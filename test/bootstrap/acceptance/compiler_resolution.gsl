import "compiler/sema"
import "compiler/codegen_validate"

func main() u32 {
    var context: CompilerContext
    compiler_context_init(&context)
    defer compiler_context_release(&context)
    var parser: Parser
    var sema: Sema
    parser_init(&parser, "func identity(x:u32) u32 { return x } func main() u32 { var x:u32=1; if true { let x:u32=2; let y=identity(x) }; return x }", &context)
    parser_parse(&parser)
    if parser.error { return 1 }
    sema_init(&sema, &context)
    sema_check(&sema, &parser)
    if sema.error { return 2 }
    let main_decl = parser_decl(&parser, 1)
    let outer = main_decl.body_start
    let branch = parser_stmt(&parser, outer).next_idx
    let inner = parser_stmt(&parser, branch).block.body_start
    let binding = parser_stmt(&parser, inner).next_idx
    let call = parser_expr(&parser, parser_stmt(&parser, binding).let_s.expr_idx)
    let argument = parser_expr(&parser, call.call.arg_start)
    let returned = parser_stmt(&parser, parser_stmt(&parser, branch).next_idx)
    let value = parser_expr(&parser, returned.ret_s.expr_idx)
    if call.resolved.declaration != 0 { return 3 }
    if argument.resolved.binding_kind != BINDING_LOCAL || argument.resolved.binding_index != inner { return 4 }
    if value.resolved.binding_kind != BINDING_LOCAL || value.resolved.binding_index != outer { return 5 }
    if codegen_preflight(&parser) == false { return 6 }
    if parser_stmt(&parser, binding).resolved_type != 32 { return 7 }
    if value.resolved.natural_type != 32 { return 8 }
    let types = parser.resolved_types.count
    let exits = parser.flow_exit_count
    if codegen_preflight(&parser) == false { return 9 }
    if parser.resolved_types.count != types || parser.flow_exit_count != exits { return 10 }
    return 0
}
