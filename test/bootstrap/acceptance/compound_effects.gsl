struct State { trace: u32 }
struct Item { value: u32 }
func index(state: *State) usize { state.trace = state.trace * 10 + 1; return 0 as usize }
func divisor(state: *State, value: *u32) u32 {
    state.trace = state.trace * 10 + 2
    unsafe { *value = 84 }
    return 2
}
func address(state: *State, value: *u32) *u32 { state.trace = state.trace * 10 + 3; return value }
func remainder(state: *State) u32 { state.trace = state.trace * 10 + 4; return 5 }
func shift(state: *State) u32 { state.trace = state.trace * 10 + 5; return 1 }
func main() u32 {
    var state: State
    state.trace = 0
    var items: [1]Item
    items[index(&state)].value /= divisor(&state, &items[0].value)
    if state.trace != 12 || items[0].value != 42 { return 1 }
    unsafe { *address(&state, &items[0].value) %= remainder(&state) }
    if state.trace != 1234 || items[0].value != 2 { return 2 }
    var values: [1]u32
    values[0] = 8
    values[index(&state)] >>= shift(&state)
    if state.trace != 123415 || values[0] != 4 { return 3 }
    return 0
}
