import "compiler/lexer"
import "std/fs"
func argument(argv: *usize) string {
    unsafe { return (*(((argv as usize) + size_of(usize)) as *usize)) as string }
}

func at(buffer: *u8, offset: usize) *u8 {
    unsafe { return ((buffer as usize) + offset) as *u8 }
}
func main(argc: u32, argv: *usize) u32 {
    if argc != 2 { return 1 }
    arena input(262145)
    let buffer = input.alloc(262145 as usize)
    let fd = open(argument(argv), 0 as u64, 0 as u64)
    if fd < 0 as i64 { return 2 }
    var used: usize = 0 as usize
    while used < 262144 as usize {
        let count = read(fd as u64, at(buffer, used), (262144 as usize) - used)
        if count < 0 as i64 { return 3 }
        if count == 0 as i64 { break }
        used += count as usize
    }
    close(fd as u64)
    unsafe { volatile_write(at(buffer, used), 0 as u8) }
    var lex: Lexer
    unsafe { lexer_init(&lex, (buffer as usize) as string) }
    var count: u32 = 0
    while count < 100000 {
        let tok = lexer_next(&lex)
        if tok.kind == TOKEN_ILLEGAL { return 4 }
        if tok.kind == TOKEN_EOF { return 0 }
        count += 1
    }
    return 5
}
