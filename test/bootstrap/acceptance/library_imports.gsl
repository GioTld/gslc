import "core/mem"
import "core/string"
import "std/fs"
import "std/io"
import "std/process"

func main() u32 {
    var source: [4]u8
    var destination: [4]u8
    let input = &source[0 as usize]
    let output = &destination[0 as usize]
    memset(input, 42 as u8, 4 as usize)
    memcpy(output, input, 4 as usize)
    if destination[0 as usize] != 42 as u8 || destination[3 as usize] != 42 as u8 { return 1 }
    var opened = fs_open_read("/dev/null")
    if opened.error != IO_OK { return 2 }
    let part = io_read(&opened.file, output, 4 as usize)
    if part.error != IO_OK || part.eof == false { return 3 }
    if fs_close(&opened.file) != IO_OK || fs_close(&opened.file) != IO_CLOSED { return 4 }
    io_print("core ")
    io_println("std")
    process_exit(0)
    return 5
}
