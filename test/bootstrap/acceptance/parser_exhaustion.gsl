import "compiler/parser"

func main() u32 {
    var context: CompilerContext
    compiler_context_init(&context)
    defer compiler_context_release(&context)
    var p: Parser
    parser_init(&p, "1", &context)
    p.error = true
    p.error_line = 1
    p.error_col = 1
    let expression = parse_expr(&p, PREC_NONE)
    if expression != INVALID_INDEX { return 1 }

    parser_init(&p, "return;", &context)
    p.error = true
    p.error_line = 1
    p.error_col = 1
    let statement = parse_stmt(&p)
    if statement != INVALID_INDEX { return 4 }
    return 0
}

