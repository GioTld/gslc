struct Owned { value: u32 }
copy struct View { data: *u8 }
copy struct Nest { view: View }
func identity(value: *u8) *u8 { return value }
func view_of(value: *u8) View { var view: View; view.data = value; return view }
func static_view() View { var view: View; unsafe { view.data = 0 as *u8 }; return view }
func read(value: *u8) u8 { unsafe { return volatile_read(value) } }
func write(value: *u8, byte: u8) { unsafe { volatile_write(value, byte) } }
func branch(flag: bool, incoming: *u8) *u8 {
    var value = incoming
    if flag { arena local(8); value = incoming; write(local.alloc(1), 3 as u8) } else { value = incoming }
    return value
}
func replace(flag: bool) View {
    arena local(8)
    var view = view_of(local.alloc(1))
    if flag { view = static_view() } else { view = static_view() }
    return view
}
func consume(value: Owned) u32 { return value.value }
func borrow_or_move(flag: bool, value: Owned) u32 {
    if flag { let view = &value; return view.value }
    return consume(value)
}
func make_owned(value: u32) Owned { var item: Owned; item.value = value; return item }
func main() u32 {
    arena storage(64)
    let first = storage.alloc(1)
    let alias = identity(first)
    write(alias, 17 as u8)
    var holder: Nest
    holder.view = view_of(first)
    let copied = holder
    if read(copied.view.data) != 17 as u8 { return 1 }
    if read(branch(true, first)) != 17 as u8 || read(branch(false, first)) != 17 as u8 { return 2 }
    var table: [2]View
    table[0].data = first
    table[1] = view_of(first)
    if read(table[1].data) != 17 as u8 { return 3 }
    var owned: Owned
    owned.value = 9
    let borrow = &owned
    let second_borrow = borrow
    if second_borrow.value != 9 { return 4 }
    var rounds: u32 = 0
    while rounds < 2 {
        arena temporary(8)
        let byte = temporary.alloc(1)
        write(byte, rounds as u8)
        if read(byte) != rounds as u8 { return 5 }
        rounds += 1
    }
    if borrow_or_move(true, make_owned(7)) != 7 || borrow_or_move(false, make_owned(8)) != 8 { return 7 }
    let cleared = replace(true)
    unsafe { if cleared.data != 0 as *u8 { return 6 } }
    return 0
}
