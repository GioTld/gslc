import "compiler/parser"
import "compiler/sema"
import "compiler/imports"

func sema_status(source: string) u32 {
    arena work(7471104)
    var p: Parser
    var s: Sema
    let storage = work.alloc((PARSER_MAX_EXPRS as usize) * size_of(Expr) + (PARSER_MAX_STMTS as usize) * size_of(Stmt) + (PARSER_MAX_PARAMS as usize) * size_of(Param) + (PARSER_MAX_DECLS as usize) * size_of(FuncDecl) + (PARSER_MAX_CONSTS as usize) * size_of(CompilerConst) + (PARSER_MAX_STRUCTS as usize) * size_of(CompilerStruct) + (PARSER_MAX_FIELDS as usize) * size_of(CompilerField))
    parser_init(&p, source, storage)
    parser_parse(&p)
    if p.error { return 1 }
    let symbols = work.alloc((SEMA_MAX_SYMBOLS as usize) * size_of(Symbol))
    sema_init(&s, symbols)
    sema_check(&s, &p)
    if s.error { return 2 }
    return 0
}

func sema_compiler_closure(path: string) u32 {
    arena input(278536)
    var imports: ImportState
    imports.output = input.alloc(262145 as usize)
    imports.paths = input.alloc(16384 as usize)
    imports.used = 0 as usize
    imports.path_count = 0
    let loaded = compiler_collect_file(path, &imports, 0)
    if loaded != 0 { return loaded }

    return sema_loaded_closure(compiler_import_as_string(imports.output));
}

func sema_loaded_closure(source: string) u32 {
    arena work(7471104)
    var p: Parser
    var s: Sema
    let storage = work.alloc((PARSER_MAX_EXPRS as usize) * size_of(Expr) + (PARSER_MAX_STMTS as usize) * size_of(Stmt) + (PARSER_MAX_PARAMS as usize) * size_of(Param) + (PARSER_MAX_DECLS as usize) * size_of(FuncDecl) + (PARSER_MAX_CONSTS as usize) * size_of(CompilerConst) + (PARSER_MAX_STRUCTS as usize) * size_of(CompilerStruct) + (PARSER_MAX_FIELDS as usize) * size_of(CompilerField))
    parser_init(&p, source, storage)
    parser_parse(&p)
    if p.error { return 1 }
    let symbols = work.alloc((SEMA_MAX_SYMBOLS as usize) * size_of(Symbol))
    sema_init(&s, symbols)
    sema_check(&s, &p)
    if s.error { return 2 }
    return 0
}

func main(argc: u32, argv: *usize) u32 {
    if sema_status("func main(argc: u32, argv: *usize) u32 { var count: u32 = 0; while count < 2 { let inner = count; if inner == 0 { count += 1; } else { break; } } return count; }") != 0 { return 1; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { if true { return missing; } return 0; }") != 2 { return 2; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { if true { let hidden = 1; } return hidden; }") != 2 { return 3; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let value = 1; if true { let value = 2; return value; } return value; }") != 0 { return 4; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let value = 1; value = 2; return value; }") != 2 { return 5; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { var value = 1; value += 2; return value; }") != 0 { return 6; }
    if sema_status("func identity(value: u32) u32 { return value; } func main(argc: u32, argv: *usize) u32 { return identity(1 + 2); }") != 0 { return 7; }
    if sema_status("func identity(value: u64) u64 { return value; } func main(argc: u32, argv: *usize) u32 { let wide = identity(11); return wide as u32; }") != 0 { return 8; }
    if sema_status("func identity(value: u64) u64 { return value; } func main(argc: u32, argv: *usize) u32 { let wide = identity(10 + 1); return wide as u32; }") != 0 { return 9; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let wide: u64 = 10 + 1; return wide as u32; }") != 0 { return 10; }
    if sema_status("func empty() void { return; } func main(argc: u32, argv: *usize) u32 { empty(); return 0; }") != 0 { return 11; }
    if sema_status("func value() i8 { return; }") != 2 { return 12; }
    if sema_status("func value(flag: bool, count: i16) i16 { if flag { return -1 >> count; } return 1; }") != 0 { return 13; }
    if sema_status("func value(left: u8, right: i8) u8 { return left + right; }") != 2 { return 14; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { var value: bool = 1; return 0; }") != 2 { return 15; }
    if sema_status("func identity(value: string) string { return value; } func main(argc: u32, argv: *usize) u32 { let text = identity(\"ok\"); return 0; }") != 0 { return 16; }
    if sema_status("struct Box { value: u32 } func main(argc: u32, argv: *usize) u32 { var box: Box; box.value = 3; return box.value; }") != 0 { return 17; }
    if sema_status("struct Box { value: u32 } func read(box: *Box) u32 { return box.value; }") != 0 { return 18; }
    if sema_status("struct Box { value: u32 } func read(box: Box) u32 { return box.missing; }") != 2 { return 19; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { var value: Unknown; return 0; }") != 2 { return 20; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { arena temp(128); let bytes = temp.alloc(4); return 0; }") != 0 { return 21; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let value = 1; let bytes = value.alloc(4); return 0; }") != 2 { return 22; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { break; return 0; }") != 2 { return 23; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { continue; return 0; }") != 2 { return 24; }
    if sema_status("func set(value: u32) u32 { value = 2; return value; }") != 2 { return 25; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { return true; }") != 2 { return 26; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let value: u32 = true; return 0; }") != 2 { return 27; }
    if sema_status("func identity(value: u32) u32 { return value; } func main(argc: u32, argv: *usize) u32 { return identity(true); }") != 2 { return 28; }
    if sema_status("func identity(value: u32) u32 { return value; } func main(argc: u32, argv: *usize) u32 { return identity(1, 2); }") != 2 { return 29; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { return 1 + true; }") != 2 { return 30; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { let wide: u64 = 2; let narrow: u32 = 1; return wide + narrow as u32; }") != 2 { return 31; }
    if sema_status("func main(argc: u32, argv: *usize) u32 { if 1 { return 0; } return 0; }") != 2 { return 32; }
    if sema_status("func read(ptr: *u8) u32 { return *ptr as u32; }") != 2 { return 33; }
    if sema_status("func read(ptr: *u8) u32 { unsafe { return *ptr as u32; } }") != 0 { return 34; }
    if sema_status("func convert(value: usize) *u8 { return value as *u8; }") != 2 { return 35; }
    if sema_status("func convert(value: usize) *u8 { unsafe { return value as *u8; } }") != 0 { return 36; }
    if sema_status("func read(ptr: *u8) u8 { return volatile_read(ptr); }") != 2 { return 37; }
    if sema_status("func read(ptr: *u8) u8 { unsafe { return volatile_read(ptr); } }") != 0 { return 38; }
    if sema_status("func read(ptr: *u8) u8 { unsafe { return volatile_read(ptr, ptr); } }") != 2 { return 39; }
    if sema_status("func read() u8 { unsafe { return volatile_read(1); } }") != 2 { return 40; }
    if sema_status("func call() i64 { return syscall(1, 2, 3, 4); }") != 2 { return 41; }
    if sema_status("func call() i64 { unsafe { return syscall(1); } }") != 2 { return 42; }
    if argc != 2 { return 240; }
    var entry: string;
    unsafe { entry = (*(((argv as usize) + size_of(usize)) as *usize)) as string; }
    return sema_compiler_closure(entry);
}
