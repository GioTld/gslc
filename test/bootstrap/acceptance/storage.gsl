import "compiler/codegen"
import "compiler/sema"
import "compiler/imports"
import "std/io"
func metric(name: string, value: u64, first: bool) {
    var output: CompilerOutput; output.fd = 1; output.error = false;
    if !first { io_print(","); }
    io_print("\""); io_print(name); io_print("\":"); codegen_write_u64(&output,value);
}
func main(argc: u32, argv: *usize) u32 {
    if argc != 2 { return 1; }
    var path: string;
    unsafe { path = (*(((argv as usize) + size_of(usize)) as *usize)) as string; }
    arena input(344072);
    var imports: ImportState;
    imports.output = input.alloc(327681 as usize);
    imports.paths = input.alloc(16384 as usize);
    imports.used = 0 as usize;
    imports.platform = 0
    imports.platform_root = ""
    imports.path_count = 0;
    if compiler_collect_file(path,&imports,0) != 0 { return 2; }
    return measure_loaded(compiler_import_as_string(imports.output),imports.used);
}
func measure_loaded(source: string, source_bytes: usize) u32 {
    arena work(6553600);
    var p: Parser;
    var s: Sema;
    let reserved = (PARSER_MAX_EXPRS as usize)*size_of(Expr)+(PARSER_MAX_STMTS as usize)*size_of(Stmt)+(PARSER_MAX_PARAMS as usize)*size_of(Param)+(PARSER_MAX_DECLS as usize)*size_of(FuncDecl)+(PARSER_MAX_CONSTS as usize)*size_of(CompilerConst)+(PARSER_MAX_STRUCTS as usize)*size_of(CompilerStruct)+(PARSER_MAX_FIELDS as usize)*size_of(CompilerField);
    let storage = work.alloc(reserved);
    parser_init(&p,source,storage);
    parser_parse(&p);
    if p.error { return 3; }
    let symbols = work.alloc((SEMA_MAX_SYMBOLS as usize)*size_of(Symbol));
    sema_init(&s,symbols);
    sema_check(&s,&p);
    if s.error { return 4; }
    var upper = p.decl_count+p.param_count+p.const_count+p.struct_count;
    var index: u32 = 0;
    while index < p.stmt_count {
        let statement=parser_stmt(&p,index);
        if statement.kind == STMT_LET || statement.kind == STMT_VAR || statement.kind == STMT_ARENA { upper += 1; }
        index += 1;
    }
    io_print("{");
    metric("expressions",p.expr_count as u64,true);
    metric("max_expressions",PARSER_MAX_EXPRS as u64,false);
    metric("statements",p.stmt_count as u64,false);
    metric("max_statements",PARSER_MAX_STMTS as u64,false);
    metric("functions",p.decl_count as u64,false);
    metric("max_functions",PARSER_MAX_DECLS as u64,false);
    metric("parameters",p.param_count as u64,false);
    metric("max_parameters",PARSER_MAX_PARAMS as u64,false);
    metric("constants",p.const_count as u64,false);
    metric("max_constants",PARSER_MAX_CONSTS as u64,false);
    metric("structs",p.struct_count as u64,false);
    metric("max_structs",PARSER_MAX_STRUCTS as u64,false);
    metric("fields",p.field_count as u64,false);
    metric("max_fields",PARSER_MAX_FIELDS as u64,false);
    metric("symbols",upper as u64,false);
    metric("max_symbols",SEMA_MAX_SYMBOLS as u64,false);
    metric("source_bytes",source_bytes as u64,false);
    metric("storage_bytes",(reserved+(SEMA_MAX_SYMBOLS as usize)*size_of(Symbol)) as u64,false);
    metric("max_locals",CODEGEN_MAX_LOCALS as u64,false);
    metric("local_bytes",((CODEGEN_MAX_LOCALS as usize)*size_of(CodegenLocal)) as u64,false);
    metric("local_arena_bytes",102400 as u64,false);
    io_println("}");
    return 0;
}
