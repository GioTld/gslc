import "compiler/codegen"
import "compiler/sema"
import "compiler/source_parse"
import "std/io"
func metric(name: string, value: u64, first: bool) {
    var output: CompilerOutput; output.fd = 1; output.error = false;
    if !first { io_print(","); }
    io_print("\""); io_print(name); io_print("\":"); codegen_write_u64(&output,value);
}
func main(argc: u32, argv: *usize) u32 {
    var context: CompilerContext
    compiler_context_init(&context)
    defer compiler_context_release(&context)
    if argc != 2 { return 1; }
    var path: string;
    unsafe { path = (*(((argv as usize) + size_of(usize)) as *usize)) as string; }
    var imports: ImportState
    compiler_import_init(&imports, 0, "", &context)
    if compiler_collect_file(path,&imports,0) != 0 { return 2; }
    return measure_loaded(&imports,imports.virtual_length);
}
func measure_loaded(imports: *ImportState, source_bytes: usize) u32 {
    var context: CompilerContext
    compiler_context_init(&context)
    defer compiler_context_release(&context)
    let storage_start = context.used_bytes;
    var p: Parser;
    var s: Sema;
    parser_init(&p,"", &context);
    compiler_parse_sources(&p, imports);
    if p.error { return 3; }
    sema_init(&s, &context);
    sema_check(&s,&p);
    if s.error { return 4; }
    let analysis_bytes = context.used_bytes - storage_start
    if codegen_preflight(&p) == false { return 5 }
    let lowering_bytes = context.used_bytes - storage_start - analysis_bytes
    var upper = p.decl_count+p.param_count+p.const_count+p.struct_count;
    var index: u32 = 0;
    while index < p.stmt_count {
        let statement=parser_stmt(&p,index);
        if statement.kind == STMT_LET || statement.kind == STMT_VAR || statement.kind == STMT_ARENA { upper += 1; }
        index += 1;
    }
    let descriptor = linux_open("/dev/null", LINUX_O_WRONLY, 0 as u64)
    if descriptor < 0 { return 6 }
    defer linux_close(descriptor as u64)
    var output: CompilerOutput
    output.fd = descriptor as u64
    output.error = false
    if codegen_emit(&p, &output) == false || output.error { return 7 }
    io_print("{");
    metric("expressions",p.expr_count as u64,true);
    metric("statements",p.stmt_count as u64,false);
    metric("functions",p.decl_count as u64,false);
    metric("parameters",p.param_count as u64,false);
    metric("constants",p.const_count as u64,false);
    metric("structs",p.struct_count as u64,false);
    metric("fields",p.field_count as u64,false);
    metric("symbols",upper as u64,false);
    metric("source_bytes",source_bytes as u64,false);
    metric("storage_bytes",analysis_bytes as u64,false);
    metric("lowering_storage_bytes",lowering_bytes as u64,false);
    metric("flow_exits",p.flow_exit_count as u64,false);
    metric("flow_cleanups",p.flow_cleanup_count as u64,false);
    metric("ir_peak_bytes",p.ir_peak_bytes as u64,false);
    metric("ir_peak_instructions",p.ir_peak_instructions as u64,false);
    metric("local_bytes",0 as u64,false);
    metric("local_arena_bytes",0 as u64,false);
    io_println("}");
    return 0;
}
