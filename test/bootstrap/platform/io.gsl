import "state"

func platform_read(handle: u64, buffer: *u8, count: usize) IoResult {
    unsafe {
        test_read_calls += 1
        test_last_handle = handle
        if test_read_mode == 1 && test_read_calls == 1 { return io_result(0 as usize, IO_INTERRUPTED, false) }
        if test_read_mode == 2 && test_read_calls > 1 { return io_result(0 as usize, IO_ERROR, false) }
        if test_read_mode == 3 { return io_result(0 as usize, IO_WOULD_BLOCK, false) }
        if test_read_mode == 4 { return io_result(0 as usize, IO_OK, false) }
        var amount = count
        if amount > 2 as usize { amount = 2 as usize }
        if amount > test_size - test_offset { amount = test_size - test_offset }
        var index: usize = 0 as usize
        while index < amount {
            unsafe { volatile_write(((buffer as usize) + index) as *u8, (test_offset + index) as u8) }
            index += 1 as usize
        }
        test_offset += amount
        return io_result(amount, IO_OK, amount == 0 as usize && count != 0 as usize)
    }
}

func platform_write(handle: u64, buffer: *u8, count: usize) IoResult {
    unsafe {
        test_write_calls += 1
        test_last_handle = handle
        if test_write_mode == 1 && test_write_calls == 1 { return io_result(0 as usize, IO_INTERRUPTED, false) }
        if test_write_mode == 2 && test_write_calls > 1 { return io_result(0 as usize, IO_WOULD_BLOCK, false) }
        if test_write_mode == 3 { return io_result(0 as usize, IO_OK, false) }
        if test_write_mode == 4 && test_write_calls > 1 { return io_result(0 as usize, IO_ERROR, false) }
        var amount = count
        if amount > 2 as usize { amount = 2 as usize }
        var index: usize = 0 as usize
        while index < amount {
            var value: u8
            unsafe { value = volatile_read(((buffer as usize) + index) as *u8) }
            test_bytes[test_written + index] = value
            index += 1 as usize
        }
        test_written += amount
        return io_result(amount, IO_OK, false)
    }
}

func platform_stdout() u64 { return 101 }
func platform_stderr() u64 { return 102 }
