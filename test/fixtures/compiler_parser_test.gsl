import "compiler/token"
import "compiler/lexer"
import "compiler/ast"
import "compiler/parser"
import "compiler/sema"
import "std/io"

func main() u32 {
    arena work(7471104)

    var p: Parser
    var s: Sema

    let src = "func id(x: u32) u32 { return x; }"

    parser_init(&p, src)
    parser_parse(&p)

    if p.error {
        io_println("Parser: ERROR")
        return 1
    }

    if p.decl_count != 1 {
        io_println("Parser: expected 1 func decl")
        return 2
    }

    let decl = parser_decl(&p, 0)

    if decl.name_len != 2 as usize {
        io_println("Parser: wrong func name length")
        return 3
    }

    if decl.param_count != 1 {
        io_println("Parser: expected 1 param")
        return 4
    }

    if decl.body_count != 1 {
        io_println("Parser: expected 1 body stmt")
        return 5
    }

    io_println("Parser: func decl OK")

    let symbols = work.alloc((SEMA_MAX_SYMBOLS as usize) * size_of(Symbol))
    sema_init(&s, symbols)
    sema_check(&s, &p)

    if s.error {
        io_println("Sema: ERROR")
        return 6
    }

    io_println("Sema: check OK")
    io_println("Hito 7E: Parser y analisis semantico en GSL funcionan correctamente")
    return 0
}
