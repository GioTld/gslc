func choose(flag: bool) u32 {
    return match flag {
        true => 1,
        false => 2
    }
}

func choose_number(value: u32) u32 {
    return match value {
        1 => 11,
        2 => 22,
        _ => 33
    }
}

func main() u32 {
    return choose(true) + choose(false) + choose_number(1) + choose_number(2) + choose_number(3) - 69
}
