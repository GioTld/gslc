import "std/fs"
func main() u32 {
    var opened = fs_create_new("/tmp/gsl_test_file.txt")
    if opened.error != IO_OK { return opened.error }
    let message = "Hello from GSL std\n"
    var bytes: *u8
    unsafe { bytes = message as *u8 }
    let written = io_write_all(&opened.file, bytes, strlen(message) as usize)
    let closed = fs_close(&opened.file)
    if written.error != IO_OK { return written.error }
    return closed
}
