import "devices/pc/serial"
import "devices/pc/vga"
import "arch/x86_64/descriptors"

func interrupt_gate() {
    serial_write_byte(73 as u8)
}

func kernel_main() {
    unsafe {
        cli()
    }
    serial_init()
    gdt_init()
    idt_init()
    vga_write_cell(0 as usize, 0 as usize, 75 as u8, 15 as u8)
    serial_write_byte(75 as u8)
    serial_write_byte(79 as u8)
    unsafe {
        asm("int3")
    }
    serial_write_byte(10 as u8)
    unsafe {
        outb(0xf4 as u16, 0 as u8)
        hlt()
    }
}
